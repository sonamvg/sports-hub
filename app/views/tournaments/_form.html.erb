<%= form_with model: tournament, class: "form-card" do |form| %>
  <%= render "shared/errors", record: tournament %>
  <% split_values = ->(value) { value.to_s.split(",").map(&:squish).reject(&:blank?) } %>
  <% selected_formats = split_values.call(tournament.competition_formats) %>
  <% selected_eligibility = split_values.call(tournament.eligibility_summary) %>
  <% selected_documents = split_values.call(tournament.required_documents) %>
  <% selected_refunds = split_values.call(tournament.refund_policy) %>
  <% custom_formats = selected_formats - Tournament::DEFAULT_COMPETITION_FORMATS %>
  <% custom_eligibility = selected_eligibility - Tournament::DEFAULT_ELIGIBILITY_RULES %>
  <% custom_documents = selected_documents - Tournament::DEFAULT_REQUIRED_DOCUMENTS %>

  <div class="form-grid two-col">
    <div class="full form-section-heading">
      <h2>Tournament basics</h2>
    </div>

    <div>
      <%= form.label :name, "Tournament name" %>
      <%= form.text_field :name, required: true %>
    </div>

    <div>
      <%= form.label :tournament_level, "Tournament level" %>
      <%= form.select :tournament_level, ["Local", "District", "State", "Regional", "National", "International"], { include_blank: "Select level" }, required: true %>
    </div>

    <div class="full">
      <%= form.label :organizing_organization, "Organising organisation" %>
      <%= form.text_field :organizing_organization, required: true, placeholder: "Academy, association, federation, or event company" %>
    </div>

    <div class="full">
      <%= form.label :description %>
      <%= form.text_area :description, rows: 4 %>
    </div>

    <div>
      <%= form.label :website_url, "Tournament website" %>
      <%= form.url_field :website_url, placeholder: "https://example.com/tournament" %>
    </div>

    <div>
      <%= form.label :logo_image, "Logo or image upload" %>
      <%= form.file_field :logo_image, accept: "image/png,image/jpeg,image/webp" %>
      <p class="field-hint">Upload a logo or square image. PNG, JPG, or WebP is accepted.</p>
      <% if tournament.logo_image.attached? %>
        <p class="field-hint">Current upload: <%= tournament.logo_image.filename %></p>
      <% end %>
    </div>

    <div class="full">
      <%= form.label :banner_image, "Banner or hero image upload" %>
      <%= form.file_field :banner_image, accept: "image/png,image/jpeg,image/webp" %>
      <p class="field-hint">Upload a wide banner image for tournament promotion pages and listing artwork.</p>
      <% if tournament.banner_image.attached? %>
        <p class="field-hint">Current upload: <%= tournament.banner_image.filename %></p>
      <% end %>
    </div>

    <div class="full form-section-heading">
      <h2>Schedule and location</h2>
    </div>

    <div>
      <%= form.label :venue %>
      <%= form.text_field :venue, required: true %>
    </div>

    <div>
      <%= form.label :city %>
      <%= form.text_field :city, required: true %>
    </div>

    <div>
      <%= form.label :state %>
      <%= form.text_field :state, required: true %>
    </div>

    <div>
      <%= form.label :country %>
      <%= form.text_field :country, value: tournament.country.presence || "India", required: true %>
    </div>

    <div>
      <%= form.label :time_zone, "Time zone" %>
      <%= form.time_zone_select :time_zone, ActiveSupport::TimeZone.all, { include_blank: "Select time zone" }, required: true %>
    </div>

    <div>
      <%= form.label :start_date %>
      <%= form.date_field :start_date, required: true %>
    </div>

    <div>
      <%= form.label :end_date %>
      <%= form.date_field :end_date, required: true %>
    </div>

    <div>
      <%= form.label :registration_opens_at %>
      <%= form.datetime_local_field :registration_opens_at, required: true %>
    </div>

    <div>
      <%= form.label :registration_closes_at %>
      <%= form.datetime_local_field :registration_closes_at, required: true %>
    </div>

    <div class="full form-section-heading">
      <h2>Registration setup</h2>
    </div>

    <div>
      <%= form.label :registration_capacity, "Registration capacity" %>
      <%= form.number_field :registration_capacity, required: true, min: 1, step: 1, placeholder: "Maximum entries" %>
    </div>

    <div>
      <%= form.label :registration_fee, "Fee per category" %>
      <%= form.number_field :registration_fee, required: true, min: 0, step: "0.01", placeholder: "0.00" %>
      <p class="field-hint">One fee applies to each selected category. Two categories at INR 1000 each means INR 2000 total.</p>
    </div>

    <div>
      <%= form.label :currency %>
      <%= form.text_field :currency, required: true, maxlength: 3, placeholder: "INR" %>
    </div>

    <div class="full form-section-heading">
      <h2>Payment details</h2>
    </div>

    <div>
      <%= form.label :payment_account_name, "Account holder name" %>
      <%= form.text_field :payment_account_name, autocomplete: "off" %>
    </div>

    <div>
      <%= form.label :payment_bank_name, "Bank name" %>
      <%= form.text_field :payment_bank_name, autocomplete: "off" %>
    </div>

    <div>
      <%= form.label :payment_account_number, "Account number" %>
      <%= form.text_field :payment_account_number, autocomplete: "off" %>
    </div>

    <div>
      <%= form.label :payment_ifsc, "IFSC" %>
      <%= form.text_field :payment_ifsc, autocomplete: "off" %>
    </div>

    <div class="full">
      <%= form.label :payment_instructions, "Payment instructions" %>
      <%= form.text_area :payment_instructions, rows: 3, placeholder: "Mention any UPI ID, reference format, or organizer payment note." %>
      <p class="field-hint">These details are shown only to signed-in athletes during registration.</p>
    </div>

    <div>
      <%= form.label :category_generation_method, "Category generation" %>
      <%= form.select :category_generation_method, [
        "Auto-generate from eligibility rules",
        "Manual categories",
        "Import categories"
      ], { include_blank: "Select category generation method" }, required: true, data: { category_generation_select: true } %>
    </div>

    <div class="full category-generation-panel" data-category-generation-panel="Auto-generate from eligibility rules" hidden>
      <div class="modal-panel">
        <div class="modal-panel-header">
          <h2>Auto-generate categories</h2>
          <span class="status-pill">Check and edit</span>
        </div>
        <div class="category-modal-grid">
          <% TournamentCategory::DEFAULT_CATEGORY_TEMPLATES.each_with_index do |template, index| %>
            <% preview = TournamentCategory.new(template.except(:key).merge(tournament: tournament)) %>
            <div class="default-category-editor">
              <label class="checkbox-option">
                <%= check_box_tag "tournament[default_category_templates][#{index}][selected]", "1", false %>
                <span><%= preview.generated_name %></span>
              </label>
              <div class="compact-category-fields">
                <%= text_field_tag "tournament[default_category_templates][#{index}][event_type]", template[:event_type], placeholder: "Event" %>
                <%= text_field_tag "tournament[default_category_templates][#{index}][gender]", template[:gender], placeholder: "Gender" %>
                <%= number_field_tag "tournament[default_category_templates][#{index}][age_min]", template[:age_min], placeholder: "Min age" %>
                <%= number_field_tag "tournament[default_category_templates][#{index}][age_max]", template[:age_max], placeholder: "Max age" %>
                <%= number_field_tag "tournament[default_category_templates][#{index}][weight_min]", template[:weight_min], step: 0.1, placeholder: "Min kg" %>
                <%= number_field_tag "tournament[default_category_templates][#{index}][weight_max]", template[:weight_max], step: 0.1, placeholder: "Max kg" %>
                <%= text_field_tag "tournament[default_category_templates][#{index}][belt_min]", template[:belt_min], placeholder: "Min belt" %>
                <%= text_field_tag "tournament[default_category_templates][#{index}][belt_max]", template[:belt_max], placeholder: "Max belt" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="full category-generation-panel" data-category-generation-panel="Import categories" hidden>
      <div class="modal-panel">
        <div class="modal-panel-header">
          <h2>Import categories</h2>
          <span class="status-pill">CSV or TSV</span>
        </div>
        <%= file_field_tag "tournament[category_import_file]", accept: ".csv,.tsv,.xls,.xlsx,text/csv,text/tab-separated-values" %>
        <p class="field-hint">Use headers: event_type, gender, age_min, age_max, weight_min, weight_max, belt_min, belt_max. CSV/TSV imports are processed now; XLSX needs a spreadsheet parser gem.</p>
      </div>
    </div>

    <div class="full category-generation-panel" data-category-generation-panel="Manual categories" hidden>
      <div class="modal-panel">
        <div class="modal-panel-header">
          <h2>Manual categories</h2>
          <button type="button" class="secondary-button button-reset" data-add-manual-category>Add category</button>
        </div>
        <div data-manual-category-list>
          <div class="manual-category-row" data-manual-category-row>
            <%= text_field_tag "tournament[manual_categories][0][event_type]", nil, placeholder: "Event type" %>
            <%= text_field_tag "tournament[manual_categories][0][gender]", nil, placeholder: "Gender" %>
            <%= number_field_tag "tournament[manual_categories][0][age_min]", nil, placeholder: "Min age" %>
            <%= number_field_tag "tournament[manual_categories][0][age_max]", nil, placeholder: "Max age" %>
            <%= number_field_tag "tournament[manual_categories][0][weight_min]", nil, step: 0.1, placeholder: "Min kg" %>
            <%= number_field_tag "tournament[manual_categories][0][weight_max]", nil, step: 0.1, placeholder: "Max kg" %>
            <%= text_field_tag "tournament[manual_categories][0][belt_min]", nil, placeholder: "Min belt" %>
            <%= text_field_tag "tournament[manual_categories][0][belt_max]", nil, placeholder: "Max belt" %>
          </div>
        </div>
        <template data-manual-category-template>
          <div class="manual-category-row" data-manual-category-row>
            <input type="text" name="tournament[manual_categories][INDEX][event_type]" placeholder="Event type">
            <input type="text" name="tournament[manual_categories][INDEX][gender]" placeholder="Gender">
            <input type="number" name="tournament[manual_categories][INDEX][age_min]" placeholder="Min age">
            <input type="number" name="tournament[manual_categories][INDEX][age_max]" placeholder="Max age">
            <input type="number" name="tournament[manual_categories][INDEX][weight_min]" step="0.1" placeholder="Min kg">
            <input type="number" name="tournament[manual_categories][INDEX][weight_max]" step="0.1" placeholder="Max kg">
            <input type="text" name="tournament[manual_categories][INDEX][belt_min]" placeholder="Min belt">
            <input type="text" name="tournament[manual_categories][INDEX][belt_max]" placeholder="Max belt">
          </div>
        </template>
      </div>
    </div>

    <div class="full">
      <%= form.label :competition_formats, "Competition formats" %>
      <div class="checklist-group" data-repeatable-other data-other-name="tournament[competition_format_other][]" data-other-option-name="tournament[competition_format_options][]" data-other-placeholder="Enter competition format">
        <% Tournament::DEFAULT_COMPETITION_FORMATS.each do |format| %>
          <label class="checkbox-option">
            <%= check_box_tag "tournament[competition_format_options][]", format, selected_formats.include?(format) %>
            <span><%= format %></span>
          </label>
        <% end %>
        <% custom_formats.each do |format| %>
          <label class="checkbox-option">
            <%= check_box_tag "tournament[competition_format_options][]", format, true %>
            <span><%= format %></span>
          </label>
        <% end %>
        <div class="other-options" data-other-list>
          <div class="other-row">
            <%= text_field_tag "tournament[competition_format_other][]", nil, placeholder: "Enter competition format" %>
          </div>
        </div>
      </div>
      <p class="field-hint">Choose defaults or type a custom format and press Enter to add it as a checked option.</p>
    </div>

    <div class="full">
      <%= form.label :eligibility_summary, "Basic eligibility" %>
      <div class="checklist-group" data-repeatable-other data-other-name="tournament[eligibility_other][]" data-other-option-name="tournament[eligibility_options][]" data-other-placeholder="Enter eligibility rule">
        <% Tournament::DEFAULT_ELIGIBILITY_RULES.each do |rule| %>
          <label class="checkbox-option">
            <%= check_box_tag "tournament[eligibility_options][]", rule, selected_eligibility.include?(rule) %>
            <span><%= rule %></span>
          </label>
        <% end %>
        <% custom_eligibility.each do |rule| %>
          <label class="checkbox-option">
            <%= check_box_tag "tournament[eligibility_options][]", rule, true %>
            <span><%= rule %></span>
          </label>
        <% end %>
        <div class="other-options" data-other-list>
          <div class="other-row">
            <%= text_field_tag "tournament[eligibility_other][]", nil, placeholder: "Enter eligibility rule" %>
          </div>
        </div>
      </div>
      <p class="field-hint">Choose defaults or type a custom rule and press Enter to add it as a checked option.</p>
    </div>

    <div class="full">
      <%= form.label :required_documents, "Required documents" %>
      <div class="checklist-group" data-repeatable-other data-other-name="tournament[required_document_other][]" data-other-option-name="tournament[required_document_options][]" data-other-placeholder="Enter required document">
        <% Tournament::DEFAULT_REQUIRED_DOCUMENTS.each do |document| %>
          <label class="checkbox-option">
            <%= check_box_tag "tournament[required_document_options][]", document, selected_documents.include?(document) %>
            <span><%= document %></span>
          </label>
        <% end %>
        <% custom_documents.each do |document| %>
          <label class="checkbox-option">
            <%= check_box_tag "tournament[required_document_options][]", document, true %>
            <span><%= document %></span>
          </label>
        <% end %>
        <div class="other-options" data-other-list>
          <div class="other-row">
            <%= text_field_tag "tournament[required_document_other][]", nil, placeholder: "Enter required document" %>
          </div>
        </div>
      </div>
      <p class="field-hint">Choose defaults or type a custom document and press Enter to add it as a checked option.</p>
    </div>

    <div class="full">
      <%= form.label :refund_policy, "Refund policy" %>
      <div class="checklist-group">
        <% Tournament::DEFAULT_REFUND_POLICIES.each do |policy| %>
          <label class="checkbox-option">
            <%= check_box_tag "tournament[refund_policy_options][]", policy, selected_refunds.include?(policy) %>
            <span><%= policy %></span>
          </label>
        <% end %>
      </div>
      <p class="field-hint">Select the refund rules that apply. Refund policy is checkbox-only.</p>
    </div>

    <div class="full form-section-heading">
      <h2>Contacts and publishing</h2>
    </div>

    <div>
      <%= form.label :primary_contact_name, "Primary contact" %>
      <%= form.text_field :primary_contact_name, required: true, autocomplete: "name" %>
    </div>

    <div>
      <%= form.label :primary_contact_email, "Primary contact email" %>
      <%= form.email_field :primary_contact_email, required: true, autocomplete: "email" %>
    </div>

    <div>
      <%= form.label :primary_contact_phone, "Primary contact mobile" %>
      <%= form.telephone_field :primary_contact_phone, required: true, autocomplete: "tel" %>
    </div>

    <div>
      <%= form.label :slug %>
      <%= form.text_field :slug %>
    </div>

    <div class="full">
      <%= form.label :status %>
      <%= form.select :status, Tournament.statuses.keys.map { |status| [status.humanize, status] } %>
      <p class="field-hint">Use the action buttons below for common draft or publish flows.</p>
    </div>

    <div class="full">
      <%= form.label :organizer_user_ids, "Other organizers" %>
      <% selected_organizers = tournament.organizer_users.reject { |organizer| organizer.id == current_user.id || organizer.id == tournament.organizer_id } %>
      <% search_organizers = @available_organizers.reject { |organizer| organizer.id == current_user.id || organizer.id == tournament.organizer_id } %>
      <div class="organizer-picker" data-organizer-picker data-organizers="<%= json_escape(search_organizers.map { |organizer| { id: organizer.id, label: "#{organizer.name} (#{organizer.email})" } }.to_json) %>">
        <div class="organizer-picker-search">
          <input type="search" placeholder="Start typing an organiser name or email" list="organizer-options">
          <button type="button" class="secondary-button button-reset" data-add-organizer>Add</button>
        </div>
        <datalist id="organizer-options">
          <% search_organizers.each do |organizer| %>
            <option value="<%= "#{organizer.name} (#{organizer.email})" %>"></option>
          <% end %>
        </datalist>
        <div class="organizer-picker-selected" data-selected-organizers>
          <% selected_organizers.each do |organizer| %>
            <span class="organizer-chip" data-organizer-chip="<%= organizer.id %>">
              <%= organizer.name %>
              <input type="hidden" name="tournament[organizer_user_ids][]" value="<%= organizer.id %>">
              <button type="button" aria-label="Remove <%= organizer.name %>" data-remove-organizer>x</button>
            </span>
          <% end %>
        </div>
        <button type="button" class="text-link button-reset invite-toggle" data-show-organizer-invite>Invite new organiser</button>
        <div class="organizer-invite-field" data-organizer-invite hidden>
          <%= email_field_tag "tournament[invite_organizer_email]", nil, placeholder: "organiser@example.com" %>
          <p class="field-hint">If the organiser is not in Sports Hub yet, enter their email. An organiser account invitation will be sent when this tournament is saved.</p>
        </div>
      </div>
      <p class="field-hint">Only verified organisers can be selected. The creator remains the super organiser for this tournament.</p>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit "Save as Draft", class: "secondary-button button-reset", formnovalidate: true %>
    <%= form.submit "Publish", class: "primary-button button-reset" %>
    <%= link_to "Cancel", tournament.persisted? ? tournament_path(tournament) : tournaments_path, class: "secondary-button" %>
  </div>
<% end %>

<script>
  document.addEventListener("keydown", function(event) {
    const input = event.target;
    const group = input.closest("[data-repeatable-other]");

    if (!group || !input.closest("[data-other-list]")) return;
    if (event.key !== "Enter") return;

    event.preventDefault();

    const value = input.value.trim();
    if (value === "") return;

    const label = document.createElement("label");
    label.className = "checkbox-option";

    const checkbox = document.createElement("input");
    checkbox.type = "checkbox";
    checkbox.name = group.dataset.otherOptionName;
    checkbox.value = value;
    checkbox.checked = true;

    const text = document.createElement("span");
    text.textContent = value;

    label.appendChild(checkbox);
    label.appendChild(text);
    group.insertBefore(label, input.closest("[data-other-list]"));
    input.value = "";
  });

  document.addEventListener("change", function(event) {
    if (!event.target.matches("[data-category-generation-select]")) return;

    updateCategoryGenerationPanels(event.target.value);
  });

  document.addEventListener("DOMContentLoaded", function() {
    const select = document.querySelector("[data-category-generation-select]");
    if (select) updateCategoryGenerationPanels(select.value);
  });

  document.addEventListener("click", function(event) {
    if (!event.target.matches("[data-add-manual-category]")) return;

    const panel = event.target.closest("[data-category-generation-panel]");
    const list = panel.querySelector("[data-manual-category-list]");
    const template = panel.querySelector("[data-manual-category-template]");
    const nextIndex = list.querySelectorAll("[data-manual-category-row]").length;
    const fragment = template.content.cloneNode(true);

    fragment.querySelectorAll("[name]").forEach(function(input) {
      input.name = input.name.replace("INDEX", nextIndex);
    });

    list.appendChild(fragment);
  });

  function updateCategoryGenerationPanels(value) {
    document.querySelectorAll("[data-category-generation-panel]").forEach(function(panel) {
      panel.hidden = panel.dataset.categoryGenerationPanel !== value;
    });
  }

  document.addEventListener("click", function(event) {
    const picker = event.target.closest("[data-organizer-picker]");
    if (!picker) return;

    if (event.target.matches("[data-add-organizer]")) {
      const input = picker.querySelector("input[type='search']");
      const selected = picker.querySelector("[data-selected-organizers]");
      const organizers = JSON.parse(picker.dataset.organizers || "[]");
      const match = organizers.find(function(organizer) {
        return organizer.label.toLowerCase() === input.value.trim().toLowerCase();
      });

      if (!match || selected.querySelector("[data-organizer-chip='" + match.id + "']")) return;

      const chip = document.createElement("span");
      chip.className = "organizer-chip";
      chip.dataset.organizerChip = match.id;

      chip.appendChild(document.createTextNode(match.label));

      const hiddenInput = document.createElement("input");
      hiddenInput.type = "hidden";
      hiddenInput.name = "tournament[organizer_user_ids][]";
      hiddenInput.value = match.id;
      chip.appendChild(hiddenInput);

      const removeButton = document.createElement("button");
      removeButton.type = "button";
      removeButton.setAttribute("aria-label", "Remove organiser");
      removeButton.setAttribute("data-remove-organizer", "");
      removeButton.textContent = "x";
      chip.appendChild(removeButton);

      selected.appendChild(chip);
      input.value = "";
    }

    if (event.target.matches("[data-remove-organizer]")) {
      event.target.closest("[data-organizer-chip]").remove();
    }

    if (event.target.matches("[data-show-organizer-invite]")) {
      const invite = picker.querySelector("[data-organizer-invite]");
      invite.hidden = false;
      invite.querySelector("input[type='email']").focus();
    }
  });
</script>

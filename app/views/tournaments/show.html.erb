<section class="page-shell"><div class="container">
  <% display_value = ->(value) { value.present? ? value : "--" } %>
  <% display_join = ->(values) { values.compact_blank.join(", ").presence || "--" } %>
  <%= render "shared/breadcrumbs", items: [
    { label: "Home", path: root_path },
    { label: "Tournaments", path: tournaments_path },
    { label: @tournament.name }
  ] %>

  <div class="page-heading">
    <div>
      <p class="eyebrow">TOURNAMENT</p>
      <h1 class="page-title"><%= @tournament.name %></h1>
      <p class="page-copy"><%= @tournament.description.presence || "Tournament registration and category information." %></p>
    </div>
    <% show_heading_actions = current_user || can_manage_tournament?(@tournament) %>
    <% if show_heading_actions %>
      <div class="form-actions">
        <% if can_manage_tournament?(@tournament) %>
        <%= link_to "Edit tournament", edit_tournament_path(@tournament), class: "secondary-button" %>
        <%= link_to "Set draw", draw_tournament_path(@tournament), class: "secondary-button" %>
        <% end %>
        <% if current_user %>
          <% if @tournament.accepting_registrations? %>
            <%= link_to "Register athlete", new_tournament_registration_path(@tournament), class: "primary-button" %>
          <% else %>
            <span class="status-pill">Registration not open</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @tournament.banner_image_source.present? %>
    <div class="tournament-banner">
      <%= image_tag @tournament.banner_image_source, alt: "#{@tournament.name} banner", loading: "lazy" %>
    </div>
  <% end %>

  <div class="detail-card tournament-summary">
    <div><strong>Venue</strong><span><%= display_join.call([@tournament.venue, @tournament.city, @tournament.state]) %></span></div>
    <div><strong>Dates</strong><span><%= @tournament.start_date.strftime("%d %b") %> – <%= @tournament.end_date.strftime("%d %b %Y") %></span></div>
    <div><strong>Level</strong><span><%= display_value.call(@tournament.tournament_level) %></span></div>
    <div><strong>Status</strong><span><%= @tournament.status.humanize %></span></div>
    <div><strong>Organisation</strong><span><%= display_value.call(@tournament.organizing_organization) %></span></div>
    <div><strong>Time zone</strong><span><%= display_value.call(@tournament.time_zone) %></span></div>
    <div><strong>Super organizer</strong><span><%= @tournament.organizer.name %></span></div>
    <div><strong>Organizers</strong><span><%= @tournament.organizer_users.order(:name).map(&:name).join(", ").presence || @tournament.organizer.name %></span></div>
    <div><strong>Website</strong><span><%= @tournament.website_url.present? ? link_to("Open site", @tournament.website_url, class: "text-link", target: "_blank", rel: "noopener") : "--" %></span></div>
    <div><strong>Registration opens</strong><span><%= @tournament.registration_opens_at&.strftime("%d %b %Y, %I:%M %p") || "--" %></span></div>
    <div><strong>Registration closes</strong><span><%= @tournament.registration_closes_at&.strftime("%d %b %Y, %I:%M %p") || "--" %></span></div>
    <div><strong>Capacity</strong><span><%= @tournament.registration_capacity || "--" %></span></div>
    <div><strong>Fee</strong><span><%= @tournament.registration_fee ? "#{@tournament.currency.presence || "INR"} #{@tournament.registration_fee}" : "--" %></span></div>
  </div>

  <div class="detail-card detail-list">
    <div><dt>Competition formats</dt><dd><%= display_value.call(@tournament.competition_formats) %></dd></div>
    <div><dt>Basic eligibility</dt><dd><%= display_value.call(@tournament.eligibility_summary) %></dd></div>
    <div><dt>Category generation</dt><dd><%= display_value.call(@tournament.category_generation_method) %></dd></div>
    <div><dt>Required documents</dt><dd><%= display_value.call(@tournament.required_documents) %></dd></div>
    <div><dt>Refund policy</dt><dd><%= display_value.call(@tournament.refund_policy) %></dd></div>
  </div>

  <% if current_user %>
    <div class="section-compact">
    <div class="page-heading compact-heading">
      <div>
        <h2 class="section-title">Registered athletes</h2>
        <p class="page-copy"><%= can_manage_tournament?(@tournament) ? "Athletes registered for this tournament." : "Your athletes registered for this tournament." %></p>
      </div>
      <%= link_to "Add athlete", new_athlete_path(return_to: tournament_path(@tournament)), class: "primary-button" %>
    </div>

    <% if @registrations.any? %>
      <div class="registered-athlete-list">
        <% @registrations.each do |registration| %>
          <% athlete = registration.athlete %>
          <article class="registered-athlete-row">
            <div>
              <span class="status-pill status-<%= registration.status %>"><%= registration.status.humanize %></span>
              <strong><%= athlete.full_name %></strong>
            </div>
            <span><strong>Category</strong><%= registration.tournament_category.name %></span>
            <span><strong>Academy</strong><%= athlete.academy&.name || "--" %></span>
            <span><strong>Weight</strong><%= registration.registered_weight ? "#{registration.registered_weight} kg" : "--" %></span>
            <%= link_to "View profile", athlete_path(athlete), class: "text-link" %>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="inline-empty-state">
        <strong>No registered athletes yet</strong>
        <p>Registrations will appear here after athletes are submitted for this tournament.</p>
        <% if @tournament.accepting_registrations? %>
          <%= link_to "Register athlete", new_tournament_registration_path(@tournament), class: "primary-button" %>
        <% end %>
      </div>
    <% end %>
    </div>
  <% end %>

  <div class="section-compact">
    <div class="page-heading compact-heading">
      <h2 class="section-title">Categories</h2>
      <% if can_manage_tournament?(@tournament) %>
        <%= link_to "Add category", new_tournament_tournament_category_path(@tournament), class: "primary-button" %>
      <% end %>
    </div>
    <div class="category-list">
      <% @categories.each do |category| %>
        <article class="category-row">
          <div class="category-main">
            <span class="status-pill"><%= category.event_type.titleize %></span>
            <h3><%= category.name %></h3>
          </div>
          <div class="category-details">
            <span><strong>Gender</strong><%= category.gender&.titleize || "Open" %></span>
            <span><strong>Age</strong><%= [category.age_min, category.age_max].compact.any? ? [category.age_min, category.age_max].compact.join("-") : "Open" %></span>
            <span><strong>Weight</strong><%= category.weight_max ? "Up to #{category.weight_max} kg" : "Open" %></span>
          </div>
          <% if can_manage_tournament?(@tournament) || (current_user && @tournament.accepting_registrations?) %>
            <div class="category-actions">
              <% if can_manage_tournament?(@tournament) %>
                <%= link_to "Edit category", edit_tournament_tournament_category_path(@tournament, category), class: "text-link" %>
              <% end %>
              <% if current_user && @tournament.accepting_registrations? %>
                <%= link_to "Register →", new_tournament_registration_path(@tournament, category_id: category.id), class: "text-link" %>
              <% end %>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>
  </div>
</div></section>

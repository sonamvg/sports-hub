<section class="page-shell"><div class="container">
  <%= render "shared/breadcrumbs", items: [
    { label: "Home", path: root_path },
    { label: "Tournaments", path: tournaments_path },
    { label: @tournament.name }
  ] %>

  <div class="page-heading">
    <div>
      <p class="eyebrow">TOURNAMENT</p>
      <h1 class="page-title"><%= @tournament.name %></h1>
      <p class="page-copy"><%= @tournament.description.presence || "Tournament registration and category information." %></p>
    </div>
    <% show_heading_actions = current_user || can_manage_tournament?(@tournament) %>
    <% if show_heading_actions %>
      <div class="form-actions">
        <% if can_manage_tournament?(@tournament) %>
        <%= link_to "Edit tournament", edit_tournament_path(@tournament), class: "secondary-button" %>
        <%= link_to "Set draw", draw_tournament_path(@tournament), class: "secondary-button" %>
        <% end %>
        <% if current_user %>
          <% if @tournament.accepting_registrations? %>
            <%= link_to "Register athlete", new_tournament_registration_path(@tournament), class: "primary-button" %>
          <% else %>
            <span class="status-pill">Registration not open</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="detail-card tournament-summary">
    <div><strong>Venue</strong><span><%= [@tournament.venue, @tournament.city, @tournament.state].compact.join(", ") %></span></div>
    <div><strong>Dates</strong><span><%= @tournament.start_date.strftime("%d %b") %> – <%= @tournament.end_date.strftime("%d %b %Y") %></span></div>
    <div><strong>Level</strong><span><%= @tournament.tournament_level.presence || "Not set" %></span></div>
    <div><strong>Status</strong><span><%= @tournament.status.humanize %></span></div>
    <div><strong>Organisation</strong><span><%= @tournament.organizing_organization.presence || "Not set" %></span></div>
    <div><strong>Time zone</strong><span><%= @tournament.time_zone.presence || "Not set" %></span></div>
    <div><strong>Super organizer</strong><span><%= @tournament.organizer.name %></span></div>
    <div><strong>Organizers</strong><span><%= @tournament.organizer_users.order(:name).map(&:name).join(", ").presence || @tournament.organizer.name %></span></div>
    <div><strong>Website</strong><span><%= @tournament.website_url.present? ? link_to("Open site", @tournament.website_url, class: "text-link", target: "_blank", rel: "noopener") : "Not set" %></span></div>
    <div><strong>Registration opens</strong><span><%= @tournament.registration_opens_at&.strftime("%d %b %Y, %I:%M %p") || "Not set" %></span></div>
    <div><strong>Registration closes</strong><span><%= @tournament.registration_closes_at&.strftime("%d %b %Y, %I:%M %p") || "Not set" %></span></div>
    <div><strong>Capacity</strong><span><%= @tournament.registration_capacity || "Not set" %></span></div>
    <div><strong>Fee</strong><span><%= @tournament.registration_fee ? "#{@tournament.currency.presence || "INR"} #{@tournament.registration_fee}" : "Not set" %></span></div>
  </div>

  <% if @tournament.competition_formats.present? || @tournament.eligibility_summary.present? || @tournament.required_documents.present? || @tournament.refund_policy.present? %>
    <div class="detail-card detail-list">
      <div><dt>Competition formats</dt><dd><%= @tournament.competition_formats.presence || "Not set" %></dd></div>
      <div><dt>Basic eligibility</dt><dd><%= @tournament.eligibility_summary.presence || "Not set" %></dd></div>
      <div><dt>Category generation</dt><dd><%= @tournament.category_generation_method.presence || "Not set" %></dd></div>
      <div><dt>Required documents</dt><dd><%= @tournament.required_documents.presence || "Not set" %></dd></div>
      <div><dt>Refund policy</dt><dd><%= @tournament.refund_policy.presence || "Not set" %></dd></div>
    </div>
  <% end %>

  <% if current_user %>
    <div class="section-compact">
    <div class="page-heading compact-heading">
      <div>
        <h2 class="section-title">My athletes</h2>
        <p class="page-copy">Athlete profiles available for this tournament registration.</p>
      </div>
      <%= link_to "Add athlete", new_athlete_path(return_to: tournament_path(@tournament)), class: "primary-button" %>
    </div>

    <% if @athletes.any? %>
      <div class="list-grid">
        <% @athletes.each do |athlete| %>
          <% registration = @registrations_by_athlete_id[athlete.id] %>
          <article class="entity-card">
            <span class="status-pill <%= registration ? "status-#{registration.status}" : "" %>">
              <%= registration ? registration.status.humanize : "Not registered" %>
            </span>
            <h2><%= athlete.full_name %></h2>
            <p><%= [athlete.academy&.name, athlete.belt&.titleize, athlete.weight && "#{athlete.weight} kg"].compact.join(" · ") %></p>
            <% if registration %>
              <div class="entity-meta">
                <span><strong>Category</strong><%= registration.tournament_category.name %></span>
              </div>
            <% end %>
            <div class="form-actions">
              <%= link_to "View profile", athlete_path(athlete), class: "text-link" %>
              <% if @tournament.accepting_registrations? && registration.blank? %>
                <%= link_to "Register →", new_tournament_registration_path(@tournament, athlete_id: athlete.id), class: "text-link" %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="inline-empty-state">
        <strong>No athlete profiles yet</strong>
        <p>Add an athlete profile to make tournament registration faster and more consistent.</p>
        <%= link_to "Add athlete", new_athlete_path(return_to: tournament_path(@tournament)), class: "primary-button" %>
      </div>
    <% end %>
    </div>
  <% end %>

  <div class="section-compact">
    <div class="page-heading compact-heading">
      <h2 class="section-title">Categories</h2>
      <% if can_manage_tournament?(@tournament) %>
        <%= link_to "Add category", new_tournament_tournament_category_path(@tournament), class: "primary-button" %>
      <% end %>
    </div>
    <div class="category-list">
      <% @categories.each do |category| %>
        <article class="category-row">
          <div class="category-main">
            <span class="status-pill"><%= category.event_type.titleize %></span>
            <h3><%= category.name %></h3>
          </div>
          <div class="category-details">
            <span><strong>Gender</strong><%= category.gender&.titleize || "Open" %></span>
            <span><strong>Age</strong><%= [category.age_min, category.age_max].compact.any? ? [category.age_min, category.age_max].compact.join("-") : "Open" %></span>
            <span><strong>Weight</strong><%= category.weight_max ? "Up to #{category.weight_max} kg" : "Open" %></span>
          </div>
          <% if can_manage_tournament?(@tournament) || (current_user && @tournament.accepting_registrations?) %>
            <div class="category-actions">
              <% if can_manage_tournament?(@tournament) %>
                <%= link_to "Edit category", edit_tournament_tournament_category_path(@tournament, category), class: "text-link" %>
              <% end %>
              <% if current_user && @tournament.accepting_registrations? %>
                <%= link_to "Register →", new_tournament_registration_path(@tournament, category_id: category.id), class: "text-link" %>
              <% end %>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>
  </div>
</div></section>

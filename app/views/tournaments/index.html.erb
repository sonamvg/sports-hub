<section class="page-shell">
  <div class="container">
    <%= render "shared/breadcrumbs", items: [
      { label: "Home", path: root_path },
      { label: "Tournaments" }
    ] %>

    <div class="page-heading">
      <div>
        <p class="eyebrow">COMPETITIONS</p>
        <h1 class="page-title">Upcoming tournaments</h1>
        <p class="page-copy">Find open events, review categories, and register for the right competition.</p>
      </div>
      <% if current_user&.can_organize_tournaments? %>
        <%= link_to new_tournament_path, class: "primary-button icon-label" do %><%= ui_icon("plus") %><span>Create tournament</span><% end %>
      <% end %>
    </div>

    <% active_filters = [params[:q], params[:country], params[:state]].compact_blank.count %>
    <%= form_with url: tournaments_path, method: :get, class: "tournament-filter-panel" do |form| %>
      <div class="filter-panel-header">
        <div>
          <span class="small-label">SEARCH</span>
          <strong>Find competitions</strong>
        </div>
        <% if active_filters.positive? %>
          <span class="status-pill"><%= pluralize(active_filters, "filter") %> active</span>
        <% else %>
          <span class="status-pill">All tournaments</span>
        <% end %>
      </div>

      <div class="tournament-filter-grid">
        <div class="filter-field search-field">
          <%= form.label :q do %><%= ui_icon("search") %><span>Search</span><% end %>
          <%= form.search_field :q, value: params[:q], placeholder: "Search tournament, venue, city, state or country" %>
        </div>

        <div class="filter-field">
          <%= form.label :country do %><%= ui_icon("globe") %><span>Country</span><% end %>
          <%= form.select :country, options_for_select(@filter_countries, params[:country]), { include_blank: "All countries" } %>
        </div>

        <div class="filter-field">
          <%= form.label :state do %><%= ui_icon("filter") %><span>State</span><% end %>
          <%= form.select :state, options_for_select(@filter_states, params[:state]), { include_blank: "All states" } %>
        </div>

        <div class="filter-actions tournament-filter-actions">
          <%= button_tag type: "submit", class: "primary-button button-reset icon-label" do %><%= ui_icon("search") %><span>Apply</span><% end %>
          <%= link_to "Clear", tournaments_path, class: "secondary-button" %>
        </div>
      </div>
    <% end %>

    <div class="list-grid">
      <% @tournaments.each do |tournament| %>
        <article class="entity-card tournament-card">
          <div class="tournament-visual">
            <%= image_with_placeholder(
              tournament.logo_image_source,
              alt: "#{tournament.name} logo",
              placeholder: tournament.name.to_s.first&.upcase || "T"
            ) %>
          </div>
          <span class="status-pill status-<%= tournament.status %>"><%= tournament.status.humanize %></span>
          <h2><%= tournament.name %></h2>
          <p><%= [tournament.venue, tournament.city].compact.join(" · ") %></p>
          <div class="entity-meta">
            <span><strong>Starts</strong><%= tournament.start_date.strftime("%d %b %Y") %></span>
            <span><strong>Organizer</strong><%= tournament.organizer.name %></span>
            <span><strong>Categories</strong><%= tournament.tournament_categories.count %></span>
          </div>
          <div class="card-links">
            <%= link_to tournament_path(tournament), class: "text-link icon-label" do %><span>View tournament</span><%= ui_icon("arrow-right") %><% end %>
            <% if can_register_for_tournament?(tournament) %>
              <%= link_to "Register", new_tournament_registration_path(tournament), class: "text-link" %>
            <% end %>
            <% if tournament.website_url.present? %>
              <%= link_to "Website", tournament.website_url, class: "text-link muted-link", target: "_blank", rel: "noopener" %>
            <% end %>
            <% if super_admin? %>
              <%= button_to "Delete", tournament_path(tournament), method: :delete, class: "reject-button delete-action-button", form: { data: { turbo_confirm: "Are you sure you want to delete #{tournament.name}?" } } %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
    <%= render "shared/pagination", pagination: @pagination %>
  </div>
</section>

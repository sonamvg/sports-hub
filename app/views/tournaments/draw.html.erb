<section class="page-shell draw-page">
  <div class="container">
    <%= render "shared/breadcrumbs", items: [
      { label: "Home", path: root_path },
      { label: "Tournaments", path: tournaments_path },
      { label: @tournament.name, path: tournament_path(@tournament) },
      { label: "Draw" }
    ] %>

    <div class="draw-heading">
      <p class="eyebrow">DRAW</p>
      <h1 class="page-title"><%= @tournament.name %></h1>
      <p class="page-copy">Draws use weight-verified athletes only. Pairings, byes, and head-guard colors are randomized; round 1 avoids same-academy matchups whenever another opponent is available.</p>
    </div>

    <% if @draws.any? %>
      <% @draws.each do |draw| %>
        <section class="draw-sheet">
          <header class="draw-sheet-header">
            <strong><%= @tournament.name.upcase %></strong>
            <span><%= [@tournament.start_date.strftime("%d %b %Y"), @tournament.venue, @tournament.city].compact_blank.join(" - ") %></span>
            <h2><%= draw.tournament_category.name.upcase %></h2>
            <p><%= pluralize(draw.entry_count, "athlete") %> · <%= draw.bracket_size %>-slot bracket · Generated <%= draw.generated_at.strftime("%d %b %Y, %I:%M %p") %></p>
          </header>

          <div class="draw-bracket" style="--round-count: <%= draw.round_count %>;">
            <% draw.matches_by_round.each do |round_number, matches| %>
              <div class="draw-round">
                <h3><%= matches.first.round_label %></h3>
                <div class="draw-round-matches">
                  <% matches.each do |match| %>
                    <article class="draw-match <%= "draw-bye-match" if match.bye? %>" style="--match-span: <%= 2**(round_number - 1) %>;">
                      <div class="draw-match-number"><%= round_number == 1 ? match.position : "#{round_number}.#{match.position}" %></div>
                      <%= form_with model: match, url: result_tournament_draw_match_path(match), method: :patch, class: "draw-match-form" do |form| %>
                        <div class="draw-entrant draw-entrant-red">
                          <span class="draw-head-guard draw-head-guard-<%= match.red_head_guard_color %>"><%= match.red_head_guard_color.titleize %></span>
                          <span class="draw-entrant-name"><%= match.red_label %></span>
                          <% if match.ready_for_result? %>
                            <%= form.select :red_head_guard_color, TournamentDrawMatch::HEAD_GUARD_COLORS.map { |color| [color.titleize, color] }, {}, class: "draw-color-select", aria: { label: "#{match.red_label} head guard color" } %>
                          <% end %>
                        </div>

                        <div class="draw-entrant draw-entrant-blue">
                          <span class="draw-head-guard draw-head-guard-<%= match.blue_head_guard_color %>"><%= match.blue_head_guard_color.titleize %></span>
                          <span class="draw-entrant-name"><%= match.blue_label %></span>
                          <% if match.ready_for_result? %>
                            <%= form.select :blue_head_guard_color, TournamentDrawMatch::HEAD_GUARD_COLORS.map { |color| [color.titleize, color] }, {}, class: "draw-color-select", aria: { label: "#{match.blue_label} head guard color" } %>
                          <% end %>
                        </div>

                        <% if match.ready_for_result? %>
                          <div class="draw-score-grid">
                            <span>R1</span>
                            <%= form.number_field :red_round_1_points, min: 0, step: 1, placeholder: "0" %>
                            <%= form.number_field :blue_round_1_points, min: 0, step: 1, placeholder: "0" %>
                            <span>R2</span>
                            <%= form.number_field :red_round_2_points, min: 0, step: 1, placeholder: "0" %>
                            <%= form.number_field :blue_round_2_points, min: 0, step: 1, placeholder: "0" %>
                            <span>R3</span>
                            <%= form.number_field :red_round_3_points, min: 0, step: 1, placeholder: "0" %>
                            <%= form.number_field :blue_round_3_points, min: 0, step: 1, placeholder: "0" %>
                          </div>

                          <div class="draw-result-bar">
                            <span><%= match.red_total_points %> - <%= match.blue_total_points %></span>
                            <% if match.complete? %>
                              <strong><%= match.winner_registration.athlete.full_name %></strong>
                            <% else %>
                              <strong>Winner pending</strong>
                            <% end %>
                          </div>

                          <%= form.submit "Save result", class: "draw-save-button" %>
                        <% elsif match.complete? %>
                          <div class="draw-result-bar draw-result-bar-complete">
                            <span>Advanced</span>
                            <strong><%= match.winner_registration.athlete.full_name %></strong>
                          </div>
                        <% else %>
                          <div class="draw-result-bar">
                            <span>Waiting</span>
                            <strong>Previous winner</strong>
                          </div>
                        <% end %>
                      <% end %>
                    </article>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>
    <% else %>
      <div class="inline-empty-state">
        <strong>No draws generated yet</strong>
        <p>Complete weight check for at least one athlete in a category, then click Set draw.</p>
      </div>
    <% end %>

    <div class="form-actions">
      <%= link_to "Back to tournament", tournament_path(@tournament), class: "primary-button" %>
      <%= link_to "Review registrations", organizer_registrations_path, class: "secondary-button" %>
    </div>
  </div>
</section>

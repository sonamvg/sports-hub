<section class="page-shell draw-page">
  <div class="container">
    <%= render "shared/breadcrumbs", items: [
      { label: "Home", path: root_path },
      { label: "Tournaments", path: tournaments_path },
      { label: @tournament.name, path: tournament_path(@tournament) },
      { label: "Draw" }
    ] %>

    <div class="draw-heading">
      <div>
        <p class="eyebrow">DRAW SHEET</p>
        <h1 class="page-title"><%= @tournament.name %></h1>
      </div>
      <div class="draw-heading-meta">
        <span><%= pluralize(@draws.sum(&:entry_count), "athlete") %></span>
        <span><%= pluralize(@draws.size, "division") %></span>
      </div>
    </div>

    <% if @draws.any? %>
      <% @draws.each do |draw| %>
        <% match_numbers = draw.tournament_draw_matches.order(:round_number, :position).pluck(:id).each_with_index.to_h { |id, index| [id, index + 1] } %>
        <section class="draw-sheet">
          <header class="draw-sheet-header">
            <div>
              <span><%= [@tournament.start_date.strftime("%d %b %Y"), @tournament.venue, @tournament.city].compact_blank.join(" / ") %></span>
              <h2><%= draw.tournament_category.name.upcase %></h2>
            </div>
            <p><%= pluralize(draw.entry_count, "athlete") %> / <%= draw.bracket_size %>-slot bracket</p>
          </header>

          <div class="draw-bracket" style="--round-count: <%= draw.round_count %>; --bracket-size: <%= draw.bracket_size %>;">
            <% draw.matches_by_round.each do |round_number, matches| %>
              <div class="draw-round">
                <h3><%= matches.first.round_label %></h3>
                <div class="draw-round-matches">
                  <% matches.each do |match| %>
                    <% match_classes = ["draw-match"] %>
                    <% match_classes << "draw-bye-match" if match.bye? %>
                    <% match_classes << "draw-ready-match" if match.ready_for_result? && !match.bye? %>
                    <% match_classes << "draw-pending-match" unless match.ready_for_result? || match.bye? %>
                    <% row_span = 2**round_number %>
                    <% row_start = ((match.position - 1) * row_span) + 1 %>
                    <% connector_height = row_span * 87 %>
                    <article class="<%= match_classes.join(" ") %>" style="--match-row-start: <%= row_start %>; --match-row-span: <%= row_span %>; --connector-height: <%= connector_height %>px;">
                      <div class="draw-match-number"><%= match_numbers[match.id] %></div>
                      <%= form_with model: match, url: result_tournament_draw_match_path(match), method: :patch, class: "draw-match-form" do |form| %>
                        <div class="draw-entrant draw-entrant-<%= match.top_chest_guard_color %> <%= "draw-entrant-empty" unless match.red_registration.present? %>">
                          <span class="draw-entrant-name"><%= match.red_label %></span>
                          <% if match.red_registration.present? && match.complete? %>
                            <span class="draw-entrant-result"><%= match.result_label_for(match.red_registration) %></span>
                          <% end %>
                        </div>

                        <div class="draw-entrant draw-entrant-<%= match.bottom_chest_guard_color %> <%= "draw-entrant-empty" unless match.blue_registration.present? %>">
                          <span class="draw-entrant-name"><%= match.blue_label %></span>
                          <% if match.blue_registration.present? && match.complete? %>
                            <span class="draw-entrant-result"><%= match.result_label_for(match.blue_registration) %></span>
                          <% end %>
                        </div>

                        <% if match.ready_for_result? && !match.bye? %>
                          <details class="draw-scoreboard">
                            <summary>
                              <span>Scoreboard</span>
                              <small><%= match.complete? ? "Frozen" : "Live" %></small>
                            </summary>

                            <% if match.complete? %>
                              <div class="draw-score-grid draw-score-grid-readonly">
                                <% (1..3).each do |round| %>
                                  <span>R<%= round %></span>
                                  <output class="draw-score-box draw-score-box-blue"><%= match.public_send(:"red_round_#{round}_points") %></output>
                                  <output class="draw-score-box draw-score-box-red"><%= match.public_send(:"blue_round_#{round}_points") %></output>
                                <% end %>
                              </div>

                              <div class="draw-result-bar draw-result-bar-complete">
                                <span>Frozen</span>
                                <strong><%= match.winner_registration.athlete.full_name %></strong>
                              </div>
                            <% else %>
                              <div class="draw-score-grid" data-draw-score-form>
                                <% (1..3).each do |round| %>
                                  <span>R<%= round %></span>
                                  <%= form.number_field :"red_round_#{round}_points", min: 0, step: 1, class: "draw-score-box draw-score-box-blue", data: { draw_score_side: "red", draw_score_round: round } %>
                                  <%= form.number_field :"blue_round_#{round}_points", min: 0, step: 1, class: "draw-score-box draw-score-box-red", data: { draw_score_side: "blue", draw_score_round: round } %>
                                <% end %>
                              </div>

                              <div class="draw-result-bar">
                                <span>Sets <%= match.red_round_wins %> - <%= match.blue_round_wins %></span>
                                <strong>Winner pending</strong>
                              </div>

                              <% submit_label = match.ready_to_freeze? ? "Freeze result" : "Save result" %>
                              <%= form.button name: "score_action", value: submit_label, class: "draw-save-button", data: { draw_score_submit: true } do %>
                                <span class="draw-save-icon draw-save-icon-save" <%= "hidden" if match.ready_to_freeze? %>><%= ui_icon("save") %></span>
                                <span class="draw-save-icon draw-save-icon-lock" <%= "hidden" unless match.ready_to_freeze? %>><%= ui_icon("lock") %></span>
                                <span data-draw-score-submit-label><%= submit_label %></span>
                              <% end %>
                            <% end %>
                          </details>
                        <% end %>
                      <% end %>
                    </article>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>
    <% else %>
      <div class="inline-empty-state">
        <strong>No draws generated yet</strong>
        <p>Complete weight check for at least one athlete in a category, then click Set draw.</p>
      </div>
    <% end %>

    <div class="form-actions">
      <%= link_to "Back to tournament", tournament_path(@tournament), class: "primary-button" %>
      <%= link_to "Review registrations", organizer_registrations_path, class: "secondary-button" %>
    </div>
  </div>
</section>

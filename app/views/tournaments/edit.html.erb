<section class="page-shell">
  <div class="container narrow">
    <%= render "shared/breadcrumbs", items: [
      { label: "Home", path: root_path },
      { label: "Tournaments", path: tournaments_path },
      { label: @tournament.name, path: tournament_path(@tournament) },
      { label: "Edit" }
    ] %>

    <p class="eyebrow">TOURNAMENT</p>
    <h1 class="page-title">Edit tournament</h1>
    <p class="page-copy">Update tournament details, registration dates, and publishing status.</p>

    <%= render "form", tournament: @tournament %>
  </div>
</section>

<section class="page-shell organizer-page">
  <div class="container">
    <%= render "shared/breadcrumbs", items: [
      { label: "Home", path: root_path },
      { label: "Organizers", path: organizers_path },
      { label: "My profile" }
    ] %>

    <div class="page-heading">
      <div>
        <p class="eyebrow">ORGANIZER</p>
        <h1 class="page-title"><%= @organizer.name %></h1>
      </div>
      <div class="form-actions">
        <%= link_to "Registration approvals", organizer_registrations_path, class: "primary-button" %>
        <%= link_to "Create tournament", new_tournament_path, class: "secondary-button" %>
      </div>
    </div>

    <div class="organizer-profile-panel">
      <div class="organizer-profile-identity">
        <div class="organizer-profile-avatar"><%= @organizer.initials %></div>
        <div>
          <span>Your organiser profile</span>
          <strong><%= @organizer.name %></strong>
        </div>
      </div>
      <div class="organizer-contact-list">
        <div>
          <span>Name</span>
          <strong><%= @organizer.name %></strong>
        </div>
        <div>
          <span>Email</span>
          <strong><%= @organizer.email %></strong>
        </div>
        <div>
          <span>Phone</span>
          <strong><%= @organizer.phone.presence || "--" %></strong>
        </div>
      </div>
    </div>

    <div class="section-compact">
      <div class="page-heading compact-heading">
        <div>
          <h2 class="section-title">Tournaments organised</h2>
        </div>
        <span class="subtle-count"><%= pluralize(@owned_tournaments.count, "event") %></span>
      </div>

      <% if @owned_tournaments.any? %>
        <div class="organizer-event-list">
          <% @owned_tournaments.each do |tournament| %>
            <article class="organizer-event-row">
              <div class="organizer-event-main">
                <span><%= tournament.start_date.strftime("%d %b %Y") %></span>
                <strong><%= tournament.name %></strong>
                <p><%= [tournament.city, tournament.state, tournament.country].compact_blank.join(", ").presence || "--" %></p>
              </div>
              <div class="organizer-event-meta">
                <span>Created</span>
                <strong><%= tournament.created_at.strftime("%d %b %Y") %></strong>
              </div>
              <span class="status-pill status-<%= tournament.status %>"><%= tournament.status.humanize %></span>
              <div class="row-actions">
                <%= link_to "View", tournament_path(tournament), class: "text-link" %>
                <%= link_to "Edit", edit_tournament_path(tournament), class: "text-link" %>
                <%= link_to "Referees", tournament_tournament_referees_path(tournament), class: "text-link" %>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="inline-empty-state">
          <strong>No tournaments created yet</strong>
          <p>Create your first tournament to begin adding categories, referees, venue details, and registrations.</p>
          <%= link_to "Create tournament", new_tournament_path, class: "primary-button" %>
        </div>
      <% end %>
    </div>

    <% if @collaborating_tournaments.any? %>
      <div class="section-compact">
        <div class="page-heading compact-heading">
          <div>
            <h2 class="section-title">Collaborating on</h2>
            <p class="page-copy">Tournaments where another organiser added you.</p>
          </div>
          <span class="subtle-count"><%= pluralize(@collaborating_tournaments.count, "event") %></span>
        </div>

        <div class="organizer-event-list">
          <% @collaborating_tournaments.each do |tournament| %>
            <article class="organizer-event-row">
              <div class="organizer-event-main">
                <span><%= tournament.start_date.strftime("%d %b %Y") %></span>
                <strong><%= tournament.name %></strong>
                <p><%= [tournament.organizer.name, tournament.city, tournament.state].compact_blank.join(" · ") %></p>
              </div>
              <span class="status-pill status-<%= tournament.status %>"><%= tournament.status.humanize %></span>
              <div class="row-actions">
                <%= link_to "View", tournament_path(tournament), class: "text-link" %>
                <%= link_to "Approvals", organizer_registrations_path, class: "text-link" %>
              </div>
            </article>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>

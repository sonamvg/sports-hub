<section class="page-shell organizer-page">
  <div class="container">
    <%= render "shared/breadcrumbs", items: [
      { label: "Home", path: root_path },
      { label: "Organizers", path: organizers_path },
      { label: "My profile" }
    ] %>

    <div class="page-heading">
      <div>
        <p class="eyebrow">ORGANIZER PROFILE</p>
        <h1 class="page-title"><%= @organizer.name %></h1>
        <p class="page-copy">Manage your organizer identity, events, approvals, referees, categories, venue setup, and tournament operations.</p>
      </div>
      <div class="form-actions">
        <%= link_to "Registration approvals", organizer_registrations_path, class: "primary-button" %>
        <%= link_to "Create tournament", new_tournament_path, class: "secondary-button" %>
      </div>
    </div>

    <div class="detail-card tournament-summary">
      <div><strong>Status</strong><span><%= @organizer.organizer_status.humanize %></span></div>
      <div><strong>Role</strong><span><%= @organizer.role.humanize %></span></div>
      <div><strong>Designation</strong><span><%= @organizer.organizer_designation || "--" %></span></div>
      <div><strong>Email</strong><span><%= @organizer.email %></span></div>
      <div><strong>Phone</strong><span><%= @organizer.phone || "--" %></span></div>
      <div><strong>Approved at</strong><span><%= @organizer.organizer_approved_at&.strftime("%d %b %Y") || "--" %></span></div>
    </div>

    <div class="section-compact">
      <div class="page-heading compact-heading">
        <div>
          <h2 class="section-title">My tournaments</h2>
          <p class="page-copy">Tournaments where you are the super organiser.</p>
        </div>
        <span class="status-pill"><%= pluralize(@owned_tournaments.count, "event") %></span>
      </div>

      <% if @owned_tournaments.any? %>
        <div class="approval-table">
          <% @owned_tournaments.each do |tournament| %>
            <div class="approval-row">
              <div>
                <strong><%= tournament.name %></strong>
                <span><%= [tournament.city, tournament.state, tournament.start_date.strftime("%d %b %Y")].compact_blank.join(" · ") %></span>
              </div>
              <span class="status-pill status-<%= tournament.status %>"><%= tournament.status.humanize %></span>
              <div class="row-actions">
                <%= link_to "View", tournament_path(tournament), class: "text-link" %>
                <%= link_to "Edit", edit_tournament_path(tournament), class: "text-link" %>
                <%= link_to "Referees", tournament_tournament_referees_path(tournament), class: "text-link" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="inline-empty-state">
          <strong>No tournaments created yet</strong>
          <p>Create your first tournament to begin adding categories, referees, venue details, and registrations.</p>
          <%= link_to "Create tournament", new_tournament_path, class: "primary-button" %>
        </div>
      <% end %>
    </div>

    <% if @collaborating_tournaments.any? %>
      <div class="section-compact">
        <div class="page-heading compact-heading">
          <div>
            <h2 class="section-title">Collaborating on</h2>
            <p class="page-copy">Tournaments where another organiser added you.</p>
          </div>
          <span class="status-pill"><%= pluralize(@collaborating_tournaments.count, "event") %></span>
        </div>

        <div class="approval-table">
          <% @collaborating_tournaments.each do |tournament| %>
            <div class="approval-row">
              <div>
                <strong><%= tournament.name %></strong>
                <span><%= [tournament.organizer.name, tournament.city, tournament.start_date.strftime("%d %b %Y")].compact_blank.join(" · ") %></span>
              </div>
              <span class="status-pill status-<%= tournament.status %>"><%= tournament.status.humanize %></span>
              <div class="row-actions">
                <%= link_to "View", tournament_path(tournament), class: "text-link" %>
                <%= link_to "Approvals", organizer_registrations_path, class: "text-link" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>

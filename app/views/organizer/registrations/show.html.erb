<section class="page-shell"><div class="container narrow"><p class="eyebrow">REGISTRATION REVIEW</p><h1 class="page-title"><%= @registration.athlete.full_name %></h1><div class="detail-card"><p><strong>Tournament:</strong> <%= @registration.tournament.name %></p><p><strong>Category:</strong> <%= @registration.tournament_category.name %></p><p><strong>Registered weight:</strong> <%= @registration.registered_weight || "Not provided" %></p><p><strong>Status:</strong> <%= @registration.status.humanize %></p><p><strong>Receipt:</strong> <% if @registration.payment_receipt.attached? %><%= link_to "View receipt", url_for(@registration.payment_receipt), class: "text-link", target: "_blank", rel: "noopener" %><% else %>--<% end %></p></div><% if @registration.pending? %><div class="form-actions"><%= button_to "Accept registration", approve_organizer_registration_path(@registration), method: :patch, class: "approve-button" %><%= button_to "Deny registration", reject_organizer_registration_path(@registration), method: :patch, class: "reject-button" %></div><% end %><% if super_admin? %><div class="section-compact"><h2 class="section-title">Action log</h2><div class="approval-table"><% @action_logs.each do |log| %><div class="approval-row"><div><strong><%= log.action.humanize %></strong><span><%= log.actor.name %> · <%= log.created_at.strftime("%d %b %Y, %I:%M %p") %></span></div><span class="status-pill"><%= [log.from_status&.humanize, log.to_status.humanize].compact.join(" → ") %></span></div><% end %></div></div><% end %></div></section>

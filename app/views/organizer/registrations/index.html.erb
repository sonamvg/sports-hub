<section class="page-shell organizer-page"><div class="container"><p class="eyebrow">ORGANIZER</p><h1 class="page-title">Registration approvals</h1><p class="page-copy">Pending registrations appear first. Any organizer assigned to a tournament can view receipts and accept or deny athletes.</p>
<div class="approval-table"><% @registrations.each do |registration| %><div class="approval-row"><div><strong><%= registration.athlete.full_name %></strong><span><%= registration.tournament.name %> · <%= registration.tournament_category.name %></span></div><span class="status-pill status-<%= registration.status %>"><%= registration.status.humanize %></span><div class="row-actions"><%= link_to "View", organizer_registration_path(registration), class: "text-link" %><% if registration.payment_receipt.attached? %><%= link_to "View receipt", url_for(registration.payment_receipt), class: "text-link", target: "_blank", rel: "noopener" %><% end %><% if registration.pending? %><%= button_to "Accept", approve_organizer_registration_path(registration), method: :patch, class: "approve-button" %><%= button_to "Deny", reject_organizer_registration_path(registration), method: :patch, class: "reject-button" %><% end %></div></div><% end %></div>
</div></section>

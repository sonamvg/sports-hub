<section class="page-shell organizer-page"><div class="container"><p class="eyebrow">ORGANIZER</p><h1 class="page-title">Registration approvals</h1><p class="page-copy">Organizers see registrations for tournaments they own. Super admins see all registrations.</p>
<div class="approval-table"><% @registrations.each do |registration| %><div class="approval-row"><div><strong><%= registration.athlete.full_name %></strong><span><%= registration.tournament.name %> · <%= registration.tournament_category.name %></span></div><span class="status-pill status-<%= registration.status %>"><%= registration.status.humanize %></span><div class="row-actions"><% if registration.pending? %><%= button_to "Approve", approve_organizer_registration_path(registration), method: :patch, class: "approve-button" %><%= button_to "Reject", reject_organizer_registration_path(registration), method: :patch, class: "reject-button" %><% else %><%= link_to "View", organizer_registration_path(registration), class: "text-link" %><% end %></div></div><% end %></div>
</div></section>

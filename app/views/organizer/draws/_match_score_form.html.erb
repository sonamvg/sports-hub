<% athlete_one = match.registration_one.athlete %>
<% athlete_two = match.registration_two.athlete %>
<% dom_id = "match_#{match.id}" %>

<article class="match-score-card" data-match-form>
  <div class="match-score-heading">
    <span class="status-pill">Round <%= match.round_number %> &middot; Match <%= match.slot_position %></span>
    <h3><span class="corner-name-red"><%= athlete_one.full_name %></span> vs <span class="corner-name-blue"><%= athlete_two.full_name %></span></h3>
    <div class="match-corner-legend">
      <span class="corner-tag corner-tag-red">Red &middot; <%= athlete_one.full_name %></span>
      <span class="corner-tag corner-tag-blue">Blue &middot; <%= athlete_two.full_name %></span>
    </div>
  </div>

  <%= form_with url: organizer_match_path(match), method: :patch, class: "match-score-fields" do %>
    <div class="form-field">
      <%= label_tag "#{dom_id}_decision", "Decision" %>
      <%= select_tag "match[decision]", options_for_select([
            [ "Select winner (no points)", "winner_only" ],
            [ "By points", "points" ],
            [ "Referee stops contest (RSC)", "rsc" ],
            [ "Disqualification", "disqualification" ],
            [ "Withdrawal", "withdrawal" ],
            [ "No-show", "no_show" ]
          ], "winner_only"), id: "#{dom_id}_decision", data: { match_decision_select: true } %>
      <p class="field-hint">Pick the winner directly &mdash; switch to "By points" only if you want to enter round scores.</p>
    </div>

    <div class="match-rounds" data-match-rounds-field>
      <% (1..3).each do |round_number| %>
        <div class="match-round-row" data-match-round-row>
          <span class="match-round-label">Round <%= round_number %></span>
          <%= number_field_tag "match[rounds][#{round_number - 1}][points_one]", nil,
                min: 0, placeholder: athlete_one.full_name, id: "#{dom_id}_round_#{round_number}_points_one",
                data: { round_points: "one" }, class: "corner-input-red" %>
          <%= number_field_tag "match[rounds][#{round_number - 1}][points_two]", nil,
                min: 0, placeholder: athlete_two.full_name, id: "#{dom_id}_round_#{round_number}_points_two",
                data: { round_points: "two" }, class: "corner-input-blue" %>
          <span class="match-round-result" data-round-result>&nbsp;</span>
          <div class="match-round-superiority" data-round-superiority-field hidden>
            <p class="field-hint">Who showed superiority?</p>
            <div class="corner-toggle" data-round-superiority-select>
              <label class="corner-toggle-option corner-toggle-red">
                <input type="radio" name="match[rounds][<%= round_number - 1 %>][superiority_winner]" value="one">
                <span><%= athlete_one.full_name %></span>
              </label>
              <label class="corner-toggle-option corner-toggle-blue">
                <input type="radio" name="match[rounds][<%= round_number - 1 %>][superiority_winner]" value="two">
                <span><%= athlete_two.full_name %></span>
              </label>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="form-field" data-match-winner-field hidden>
      <label>Winner</label>
      <div class="corner-toggle">
        <label class="corner-toggle-option corner-toggle-red">
          <input type="radio" name="match[winner_side]" value="one">
          <span><%= athlete_one.full_name %></span>
        </label>
        <label class="corner-toggle-option corner-toggle-blue">
          <input type="radio" name="match[winner_side]" value="two">
          <span><%= athlete_two.full_name %></span>
        </label>
      </div>
    </div>

    <div class="form-actions">
      <%= submit_tag "Save result", class: "primary-button button-reset" %>
    </div>
  <% end %>
</article>

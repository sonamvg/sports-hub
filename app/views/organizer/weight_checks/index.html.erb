<section class="page-shell"><div class="container">
<%= render "shared/breadcrumbs", items: [
  { label: "Home", path: root_path },
  { label: "Tournaments", path: tournaments_path },
  { label: @tournament.name, path: tournament_path(@tournament) },
  { label: "Weight check" }
] %>

<div class="page-heading">
  <div>
    <p class="eyebrow">WEIGHT CHECK</p>
    <h1 class="page-title"><%= @tournament.name %></h1>
    <p class="page-copy">Search for an athlete by name, or browse by category. Record up to three locked weight attempts.</p>
  </div>
  <div class="page-actions">
    <%= link_to "Set draws ->", tournament_tournament_categories_path(@tournament), class: "secondary-button" %>
  </div>
</div>

<%= form_with url: organizer_tournament_weight_checks_path(@tournament), method: :get, class: "filter-bar" do |form| %>
  <div>
    <%= form.label :q, "Search athlete" %>
    <%= form.search_field :q, value: @query, placeholder: "Name or association ID" %>
  </div>
  <div>
    <%= form.label :category_id, "Category" %>
    <%= form.select :category_id, @categories.map { |category| [category.name, category.id] }, { include_blank: "All categories", selected: @category_id } %>
  </div>
  <div class="filter-actions">
    <%= button_tag type: "submit", class: "primary-button button-reset" do %>Search<% end %>
    <%= link_to "Clear", organizer_tournament_weight_checks_path(@tournament), class: "secondary-button" %>
  </div>
<% end %>

<div class="weight-check-list">
  <% if @grouped_registrations.any? %>
    <% @grouped_registrations.each do |category, registrations| %>
      <div class="weight-check-category-group">
        <div class="page-heading compact-heading weight-check-category-heading">
          <h2 class="section-title"><%= category.name %></h2>
          <span class="status-pill"><%= registrations.count { |registration| registration.weight_verified? || registration.disqualified? } %> of <%= registrations.size %> done</span>
        </div>

        <% registrations.each do |registration| %>
          <% athlete = registration.athlete %>
          <% attempts = registration.registration_weight_checks.sort_by(&:attempt_number) %>
          <article class="weight-check-row" id="weight-check-registration-<%= registration.id %>" data-weight-check-row data-registration-id="<%= registration.id %>">
            <div class="weight-check-main">
              <span class="status-pill status-<%= registration.status %>"><%= registration.status.humanize %></span>
              <h2><%= athlete.full_name %></h2>
              <p><%= registration.tournament_category.name %> · Target: <%= registration.category_weight_range %></p>
              <p class="muted"><%= athlete.academy&.name || "--" %><%= athlete.association_id.present? ? " · #{athlete.association_id}" : "" %></p>
            </div>

            <div class="attempt-list">
              <% 1.upto(3) do |attempt_number| %>
                <% attempt = attempts.find { |entry| entry.attempt_number == attempt_number } %>
                <div class="attempt-slot">
                  <strong>Attempt <%= attempt_number %></strong>
                  <% if attempt %>
                    <span><%= attempt.weight %> kg</span>
                    <small><%= attempt.passed? ? "Passed" : "Failed" %> · <%= attempt.checked_by.name %></small>
                  <% else %>
                    <span>--</span>
                    <small>Not recorded</small>
                  <% end %>
                </div>
              <% end %>
            </div>

            <% if registration.weight_check_attempts_remaining? %>
              <%= form_with model: RegistrationWeightCheck.new, url: organizer_registration_weight_checks_path(registration), class: "attempt-form" do |form| %>
                <%= hidden_field_tag :q, @query %>
                <%= hidden_field_tag :category_id, @category_id %>
                <%= form.label :weight, "Next weight (kg)" %>
                <%= form.number_field :weight, step: 0.1, min: 1, required: true, autofocus: @registrations.one? %>
                <%= form.submit "Save", class: "primary-button button-reset" %>
              <% end %>
            <% else %>
              <div class="attempt-closed"><%= registration.weight_verified? ? "Weight verified" : "Closed" %></div>
            <% end %>
          </article>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="inline-empty-state">
      <strong>No accepted athletes found</strong>
      <p>Accept registrations first, then return here for weigh-in.</p>
    </div>
  <% end %>
</div>
</div></section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var params = new URLSearchParams(window.location.search);
    var highlightId = params.get("highlight");
    if (!highlightId) return;

    var row = document.querySelector('[data-weight-check-row][data-registration-id="' + highlightId + '"]');
    if (row) {
      row.scrollIntoView({ behavior: "smooth", block: "center" });
      row.classList.add("weight-check-row-highlighted");
      setTimeout(function() { row.classList.remove("weight-check-row-highlighted"); }, 2600);
    }

    params.delete("highlight");
    var newSearch = params.toString();
    var newUrl = window.location.pathname + (newSearch ? "?" + newSearch : "") + window.location.hash;
    window.history.replaceState({}, "", newUrl);
  });
</script>

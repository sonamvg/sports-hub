<%= form_with model: [tournament, category], class: "form-card" do |form| %>
  <%= render "shared/errors", record: category %>

  <div class="form-grid two-col">
    <div class="full">
      <%= label_tag :generated_category_name, "Generated name" %>
      <%= text_field_tag :generated_category_name, category.generated_name, readonly: true, data: { generated_category_name: true } %>
    </div>

    <div>
      <%= form.label :event_type %>
      <%= form.select :event_type, [["Kyorugi", "kyorugi"], ["Poomsae", "poomsae"], ["Para", "para"]], include_blank: "Select event", required: true, data: { category_name_source: true } %>
    </div>

    <div>
      <%= form.label :gender %>
      <%= form.select :gender, [["Female", "female"], ["Male", "male"], ["Mixed", "mixed"]], include_blank: "Open", data: { category_name_source: true } %>
    </div>

    <div>
      <%= form.label :age_min, "Minimum age" %>
      <%= form.number_field :age_min, min: 1, data: { category_name_source: true } %>
    </div>

    <div>
      <%= form.label :age_max, "Maximum age" %>
      <%= form.number_field :age_max, min: 1, data: { category_name_source: true } %>
    </div>

    <div>
      <%= form.label :weight_min, "Minimum weight (kg)" %>
      <%= form.number_field :weight_min, step: 0.1, min: 1, data: { category_name_source: true } %>
    </div>

    <div>
      <%= form.label :weight_max, "Maximum weight (kg)" %>
      <%= form.number_field :weight_max, step: 0.1, min: 1, data: { category_name_source: true } %>
    </div>

    <div>
      <%= form.label :belt_min, "Minimum belt" %>
      <%= form.select :belt_min, ["white", "yellow", "green", "blue", "red", "black"], include_blank: "Open", data: { category_name_source: true } %>
    </div>

    <div>
      <%= form.label :belt_max, "Maximum belt" %>
      <%= form.select :belt_max, ["white", "yellow", "green", "blue", "red", "black"], include_blank: "Open", data: { category_name_source: true } %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit category.persisted? ? "Update category" : "Create category", class: "primary-button button-reset" %>
    <%= link_to "Cancel", category.persisted? ? tournament_tournament_category_path(tournament, category) : tournament_path(tournament), class: "secondary-button" %>
  </div>
<% end %>

<script>
  document.addEventListener("input", updateGeneratedCategoryName);
  document.addEventListener("change", updateGeneratedCategoryName);
  document.addEventListener("DOMContentLoaded", updateGeneratedCategoryName);

  function updateGeneratedCategoryName(event) {
    if (event && event.target && event.target.nodeType === 1 && !event.target.matches("[data-category-name-source]")) return;

    const output = document.querySelector("[data-generated-category-name]");
    if (!output) return;

    const valueFor = function(id) {
      const field = document.getElementById("tournament_category_" + id);
      return field ? field.value.trim() : "";
    };
    const titleize = function(value) {
      return value.replace(/_/g, " ").replace(/\b\w/g, function(letter) { return letter.toUpperCase(); });
    };
    const formatNumber = function(value) {
      if (value === "") return "";
      const number = Number(value);
      return Number.isInteger(number) ? String(number) : String(number).replace(/0+$/, "").replace(/\.$/, "");
    };

    const parts = [];
    const eventType = valueFor("event_type");
    const gender = valueFor("gender");
    const ageMin = valueFor("age_min");
    const ageMax = valueFor("age_max");
    const weightMin = valueFor("weight_min");
    const weightMax = valueFor("weight_max");
    const beltMin = valueFor("belt_min");
    const beltMax = valueFor("belt_max");

    if (eventType) parts.push(titleize(eventType));
    if (gender) parts.push(titleize(gender));

    if (ageMin && ageMax) {
      parts.push("Age " + ageMin + "-" + ageMax);
    } else if (ageMin) {
      parts.push("Age " + ageMin + "+");
    } else if (ageMax) {
      parts.push("Age U" + ageMax);
    }

    if (weightMin && weightMax) {
      parts.push(formatNumber(weightMin) + "-" + formatNumber(weightMax) + "kg");
    } else if (weightMin) {
      parts.push("Over " + formatNumber(weightMin) + "kg");
    } else if (weightMax) {
      parts.push("U" + formatNumber(weightMax));
    }

    if (beltMin && beltMax) {
      parts.push(titleize(beltMin) + "-" + titleize(beltMax));
    } else if (beltMin) {
      parts.push(titleize(beltMin) + "+");
    } else if (beltMax) {
      parts.push("Up to " + titleize(beltMax));
    }

    output.value = parts.join(" ") || "Tournament category";
  }
</script>

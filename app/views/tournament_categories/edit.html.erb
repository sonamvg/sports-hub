<section class="page-shell">
  <div class="container narrow">
    <%= render "shared/breadcrumbs", items: [
      { label: "Home", path: root_path },
      { label: "Tournaments", path: tournaments_path },
      { label: @tournament.name, path: tournament_path(@tournament) },
      { label: "Categories", path: tournament_tournament_categories_path(@tournament) },
      { label: @category.name, path: tournament_tournament_category_path(@tournament, @category) },
      { label: "Edit" }
    ] %>

    <p class="eyebrow">CATEGORY</p>
    <h1 class="page-title">Edit category</h1>
    <p class="page-copy">Update eligibility rules for <%= @tournament.name %>.</p>

    <%= render "form", tournament: @tournament, category: @category %>
  </div>
</section>

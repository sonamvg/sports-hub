<section class="page-shell">
  <div class="container">
    <%= render "shared/breadcrumbs", items: [
      { label: "Home", path: root_path },
      { label: "Tournaments", path: tournaments_path },
      { label: @tournament.name, path: tournament_path(@tournament) },
      { label: "Categories" }
    ] %>

    <div class="page-heading">
      <div>
        <p class="eyebrow">CATEGORIES</p>
        <h1 class="page-title"><%= @tournament.name %></h1>
        <% if can_edit_tournament_categories?(@tournament) %>
          <p class="page-copy">Select default taekwondo categories for this tournament, then add custom categories only where the event needs something specific.</p>
        <% elsif can_manage_tournament?(@tournament) %>
          <p class="page-copy">Categories are locked because registration has started.</p>
        <% end %>
      </div>
      <% if can_edit_tournament_categories?(@tournament) %>
        <%= link_to "Add category", new_tournament_tournament_category_path(@tournament), class: "primary-button" %>
      <% end %>
    </div>

    <% if can_edit_tournament_categories?(@tournament) %>
      <%= form_with url: create_defaults_tournament_tournament_categories_path(@tournament), method: :post, class: "form-card default-category-card" do %>
        <div class="form-section-heading">
          <h2>Default categories</h2>
        </div>
        <div class="default-category-grid">
          <% @default_templates.each do |template| %>
            <% preview = TournamentCategory.new(template.except(:key).merge(tournament: @tournament)) %>
            <% existing = @tournament.tournament_categories.exists?(template.except(:key)) %>
            <label class="checkbox-option default-category-option <%= "muted" if existing %>">
              <%= check_box_tag "template_keys[]", template[:key], false, disabled: existing %>
              <span><%= preview.generated_name %><%= " (already added)" if existing %></span>
            </label>
          <% end %>
        </div>
        <div class="form-actions">
          <%= submit_tag "Add selected defaults", class: "primary-button button-reset" %>
        </div>
      <% end %>
    <% end %>

    <div class="section-compact">
      <div class="page-heading compact-heading">
        <h2 class="section-title">Tournament categories</h2>
        <span class="status-pill"><%= @categories.count %> total</span>
      </div>
    </div>

    <div class="category-list">
      <% @categories.each do |category| %>
        <article class="category-row">
          <div class="category-main">
            <span class="status-pill"><%= category.event_type.titleize %></span>
            <h3><%= category.name %></h3>
          </div>
          <div class="category-details">
            <span><strong>Gender</strong><%= category.gender&.titleize || "Open" %></span>
            <span><strong>Age</strong><%= [category.age_min, category.age_max].compact.any? ? [category.age_min, category.age_max].compact.join("-") : "Open" %></span>
            <span><strong>Weight</strong><%= category.weight_min.present? && category.weight_max.present? ? "#{category.weight_min}-#{category.weight_max} kg" : (category.weight_max ? "Up to #{category.weight_max} kg" : "Open") %></span>
          </div>
          <% if can_edit_tournament_categories?(@tournament) %>
            <%= link_to "Edit →", edit_tournament_tournament_category_path(@tournament, category), class: "text-link" %>
          <% else %>
            <%= link_to "View →", tournament_tournament_category_path(@tournament, category), class: "text-link" %>
          <% end %>
        </article>
      <% end %>
    </div>
  </div>
</section>

<section class="page-shell">
  <div class="container">
    <%= render "shared/breadcrumbs", items: [
      { label: "Home", path: root_path },
      { label: "Tournaments", path: tournaments_path },
      { label: @tournament.name, path: tournament_path(@tournament) },
      { label: "Categories" }
    ] %>

    <div class="page-heading">
      <div>
        <p class="eyebrow">CATEGORIES</p>
        <h1 class="page-title"><%= @tournament.name %></h1>
        <p class="page-copy">This tournament uses PodiumCircle default categories.</p>
      </div>
    </div>

    <div class="section-compact">
      <div class="page-heading compact-heading">
        <h2 class="section-title">Tournament categories</h2>
        <span class="status-pill"><%= @categories.count %> total</span>
      </div>
    </div>

    <div class="category-list">
      <% @categories.each do |category| %>
        <article class="category-row">
          <div class="category-main">
            <span class="status-pill"><%= category.event_type.titleize %></span>
            <h3><%= category.name %></h3>
          </div>
          <div class="category-details">
            <span><strong>Gender</strong><%= category.gender&.titleize || "Open" %></span>
            <span><strong>Age</strong><%= [category.age_min, category.age_max].compact.any? ? [category.age_min, category.age_max].compact.join("-") : "Open" %></span>
            <span><strong>Weight</strong><%= category.weight_min.present? && category.weight_max.present? ? "#{category.weight_min}-#{category.weight_max} kg" : (category.weight_max ? "Up to #{category.weight_max} kg" : "Open") %></span>
          </div>
          <%= link_to "View ->", tournament_tournament_category_path(@tournament, category), class: "text-link" %>
        </article>
      <% end %>
    </div>
  </div>
</section>

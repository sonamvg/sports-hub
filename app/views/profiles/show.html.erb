<section class="page-shell"><div class="container narrow">
  <%= render "shared/breadcrumbs", items: [
    { label: "Home", path: root_path },
    { label: "My profile" }
  ] %>

  <p class="eyebrow">MY PROFILE</p><h1 class="page-title"><%= current_user.name %></h1>

  <%= render "shared/errors", record: current_user %>

  <div class="detail-card">
    <dl class="detail-list">
      <div><dt>Email</dt><dd><%= current_user.email %></dd></div>
      <div><dt>Role</dt><dd><%= current_user.role.humanize %></dd></div>
    </dl>
    <p class="field-hint">Email and role can't be changed here.</p>
  </div>

  <div class="form-section-heading"><h2>Edit profile</h2></div>

  <%= form_with url: profile_path, method: :patch, model: current_user, class: "form-card" do |form| %>
    <div class="form-grid">
      <div>
        <%= form.label :name %>
        <%= form.text_field :name, required: true, autocomplete: "name", pattern: "[a-zA-Z\\s'\\-]+", title: "Letters, spaces, hyphens, and apostrophes only" %>
        <%= field_error(current_user, :name) %>
      </div>
      <div>
        <%= form.label :phone, "Phone number" %>
        <%= form.telephone_field :phone, autocomplete: "tel", pattern: "\\d{10}", maxlength: 10, title: "10-digit mobile number" %>
        <%= field_error(current_user, :phone) %>
      </div>
    </div>
    <div class="form-actions">
      <%= form.submit "Save changes", class: "primary-button button-reset" %>
    </div>
  <% end %>

  <div class="form-section-heading"><h2>Change password</h2></div>

  <%= form_with url: update_password_profile_path, method: :patch, model: current_user, class: "form-card" do |form| %>
    <div class="form-grid">
      <div>
        <%= form.label :current_password, "Current password" %>
        <%= form.password_field :current_password, required: true, autocomplete: "current-password" %>
        <%= field_error(current_user, :current_password) %>
      </div>
      <div>
        <%= form.label :password, "New password" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, pattern: "(?=.*[A-Za-z])(?=.*\\d)\\S{8,}", title: "At least 8 characters, with a letter and a number, and no spaces" %>
        <%= field_error(current_user, :password) %>
      </div>
      <div>
        <%= form.label :password_confirmation, "Confirm new password" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
        <%= field_error(current_user, :password_confirmation) %>
      </div>
    </div>
    <div class="form-actions">
      <%= form.submit "Update password", class: "primary-button button-reset" %>
    </div>
  <% end %>

  <% if current_user.athlete? || current_user.academy_owner? || current_user.organizer? %>
    <div class="form-section-heading"><h2>Delete account</h2></div>
    <div class="detail-card">
      <% if current_user.athlete? %>
        <p class="field-hint">This permanently deletes your account and your athlete profile, including tournament registrations. This can't be undone.</p>
      <% elsif current_user.academy_owner? %>
        <p class="field-hint">This permanently deletes your account and your academy. Athletes on its roster stay in PodiumCircle &mdash; they just won't be linked to this academy anymore. This can't be undone.</p>
      <% else %>
        <p class="field-hint">This removes your tournaments that haven't concluded yet. Tournaments that have already completed, been cancelled, or been archived are preserved, and your account is deactivated rather than deleted so those records stay intact. This can't be undone.</p>
      <% end %>
      <%= button_to "Delete account", profile_path, method: :delete, class: "reject-button", form: { data: { turbo_confirm: "Are you sure you want to delete your account? This can't be undone." } } %>
    </div>
  <% end %>
</div></section>

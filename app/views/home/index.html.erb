<main>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">ONE PLATFORM. EVERY COMPETITION.</p>
        <h1>Train. Compete.<br><span>Grow.</span></h1>
        <p class="hero-copy">A simple platform for athletes, parents, academies and organizers to discover tournaments, register athletes and manage competition journeys.</p>
        <div class="hero-actions">
          <a class="primary-button" href="<%= tournaments_path %>">Find competitions</a>
          <a class="secondary-button" href="<%= current_user ? new_athlete_path : login_path(return_to: new_athlete_path) %>">Register an athlete</a>
          <a class="secondary-button" href="<%= new_academy_path %>">Register academy</a>
        </div>
      </div>
      <div class="hero-card">
        <div class="belt-mark">🥋</div>
        <p class="small-label">PLATFORM ROLES</p>
        <div class="flow-list">
          <span>Visitor</span><b>→</b><span>Athlete</span><b>→</b><span>Academy owner</span><b>→</b><span>Organizer</span><b>→</b><span>Super admin</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="previous-competitions">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">PREVIOUS COMPETITIONS</p>
          <h2>Recent tournaments from the wider taekwondo calendar.</h2>
        </div>
        <%= link_to "View upcoming", tournaments_path, class: "secondary-button" %>
      </div>

      <div class="previous-competitions">
        <% @previous_competitions.each do |competition| %>
          <article class="competition-card">
            <div>
              <span class="small-label"><%= competition[:organizer] %></span>
              <h3><%= competition[:name] %></h3>
              <p><%= competition[:location] %></p>
            </div>
            <div class="competition-card-footer">
              <span><%= competition[:dates] %></span>
              <%= link_to "Event page", competition[:url], class: "text-link", target: "_blank", rel: "noopener" %>
            </div>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <section class="dark-section" id="sports-news">
    <div class="container">
      <p class="eyebrow light">SPORTS NEWS</p>
      <h2>Domestic and international notes to watch.</h2>
      <div class="news-board">
        <% @sports_news.each do |scope, items| %>
          <section class="news-column">
            <h3><%= scope.to_s.titleize %></h3>
            <% items.each do |item| %>
              <article class="news-note">
                <span class="small-label"><%= item[:source] %></span>
                <h4><%= item[:title] %></h4>
                <p><%= item[:note] %></p>
                <%= link_to "Read source", item[:url], class: "text-link light-link", target: "_blank", rel: "noopener" %>
              </article>
            <% end %>
          </section>
        <% end %>
      </div>
    </div>
  </section>

  <section class="section" id="taekwondo-blogs">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">TAEKWONDO BLOGS</p>
          <h2>Good reading for athletes, parents, coaches and organizers.</h2>
        </div>
      </div>

      <div class="resource-grid">
        <% @taekwondo_blogs.each do |blog| %>
          <article class="resource-card">
            <h3><%= blog[:title] %></h3>
            <p><%= blog[:note] %></p>
            <%= link_to "Read blog", blog[:url], class: "text-link", target: "_blank", rel: "noopener" %>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <section class="section resource-section-alt" id="taekwondo-videos">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">YOUTUBE PICKS</p>
          <h2>Widely watched taekwondo videos to study and share.</h2>
        </div>
      </div>

      <div class="video-list">
        <% @taekwondo_videos.each_with_index do |video, index| %>
          <article class="video-row">
            <span><%= format("%02d", index + 1) %></span>
            <div>
              <h3><%= video[:title] %></h3>
              <p><%= video[:note] %></p>
            </div>
            <%= link_to "Open YouTube", video[:url], class: "text-link", target: "_blank", rel: "noopener" %>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <section class="section" id="get-started">
    <div class="container cta">
      <div><p class="eyebrow">SPORTS HUB</p><h2>Your competition journey, in one place.</h2></div>
      <%= link_to "Create athlete profile", current_user ? new_athlete_path : login_path(return_to: new_athlete_path), class: "primary-button" %>
      <%= link_to "Submit academy", new_academy_path, class: "secondary-button" %>
    </div>
  </section>
</main>

<footer><div class="container footer-inner"><span>Sports Hub</span><span>Built for athletes, academies and organizers.</span></div></footer>

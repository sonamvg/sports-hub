<section class="page-shell">
  <div class="container">
    <div class="page-heading">
      <div><p class="eyebrow">ATHLETES</p><h1 class="page-title">My athletes</h1><p class="page-copy">Create and manage athlete profiles before registering for competitions.</p></div>
      <%= link_to "Add athlete", new_athlete_path, class: "primary-button" %>
    </div>

    <div class="list-grid">
      <% @athletes.each do |athlete| %>
        <article class="entity-card">
          <div><span class="status-pill"><%= athlete.belt.presence || "Belt not set" %></span><h2><%= athlete.full_name %></h2><p><%= athlete.academy&.name || "No academy selected" %></p></div>
          <div class="entity-meta"><span><strong>DOB</strong><%= athlete.date_of_birth.strftime("%d %b %Y") %></span><span><strong>Weight</strong><%= athlete.weight ? "#{athlete.weight} kg" : "—" %></span></div>
          <%= link_to "View profile →", athlete_path(athlete), class: "text-link" %>
        </article>
      <% end %>
    </div>
  </div>
</section>

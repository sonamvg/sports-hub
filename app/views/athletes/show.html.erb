<section class="page-shell"><div class="container narrow">
  <%= render "shared/breadcrumbs", items: [
    { label: "Home", path: root_path },
    { label: "Athletes", path: athletes_path },
    (@athlete.academy.present? ? { label: @athlete.academy.name, path: academy_path(@athlete.academy) } : nil),
    { label: @athlete.full_name }
  ].compact %>

  <p class="eyebrow">ATHLETE PROFILE</p><h1 class="page-title"><%= @athlete.full_name %></h1>
  <div class="athlete-photo">
    <%= image_with_placeholder(
      @athlete.profile_photo.attached? ? @athlete.profile_photo : nil,
      alt: "#{@athlete.full_name} photo",
      placeholder: @athlete.full_name.to_s.split.map(&:first).join.first(2).presence || "A"
    ) %>
  </div>
  <div class="detail-card">
    <dl class="detail-list">
      <div><dt>Academy</dt><dd><%= @athlete.academy_display_name || "Not selected" %></dd></div>
      <% if @athlete.pending_academy_request.present? %>
        <div><dt>Academy request</dt><dd>Pending approval from <%= @athlete.pending_academy_request.academy.name %></dd></div>
      <% end %>
      <div><dt>Date of birth</dt><dd><%= @athlete.date_of_birth.strftime("%d %B %Y") %></dd></div>
      <div><dt>Gender</dt><dd><%= @athlete.gender.titleize %></dd></div>
      <div><dt>Belt</dt><dd><%= @athlete.belt&.titleize || "Not set" %></dd></div>
      <div><dt>Weight</dt><dd><%= @athlete.weight ? "#{@athlete.weight} kg" : "Not set" %></dd></div>
      <div><dt>Blood group</dt><dd><%= @athlete.blood_group || "Not set" %></dd></div>
      <% unless current_user.athlete? %>
        <div><dt>Association ID</dt><dd><%= @athlete.association_id || "Not set" %></dd></div>
      <% end %>
      <div><dt>Contact number</dt><dd><%= @athlete.contact_number || "Not set" %></dd></div>
      <div>
        <dt>Emergency contact</dt>
        <dd>
          <% emergency_contact_parts = [@athlete.emergency_contact_name, @athlete.emergency_contact_phone].compact_blank %>
          <% if emergency_contact_parts.any? %>
            <% emergency_contact_parts.each do |contact_part| %>
              <span class="stacked-detail"><%= contact_part %></span>
            <% end %>
          <% else %>
            Not set
          <% end %>
        </dd>
      </div>
      <div><dt>Address</dt><dd><%= [@athlete.address, @athlete.city, @athlete.state, @athlete.country].compact_blank.join(", ").presence || "Not set" %></dd></div>
      <div><dt>Government ID</dt><dd><%= @athlete.government_id_document_type || "Not set" %><%= @athlete.identity_document.attached? ? " · Uploaded" : "" %></dd></div>
    </dl>
    <div class="form-actions">
      <% if @return_to.present? %>
        <%= link_to @return_to, class: "secondary-button icon-label" do %><%= ui_icon("arrow-right") %><span>Back</span><% end %>
      <% end %>
      <% if super_admin? || @athlete.user_id == current_user.id %>
        <%= link_to edit_athlete_path(@athlete), class: "primary-button icon-label" do %><%= ui_icon("edit") %><span>Edit profile</span><% end %>
      <% end %>
      <% if super_admin? %>
        <%= button_to "Delete athlete", athlete_path(@athlete), method: :delete, class: "reject-button", form: { data: { turbo_confirm: "Delete #{@athlete.full_name}?" } } %>
      <% end %>
      <%= link_to tournaments_path, class: "secondary-button icon-label" do %><%= ui_icon("trophy") %><span>Find tournaments</span><% end %>
    </div>
  </div>
  <div class="section-compact">
    <h2 class="section-title">Upcoming tournaments</h2>
    <div class="athlete-event-table">
      <% if @upcoming_registrations.any? %>
        <% @upcoming_registrations.each do |registration| %>
          <% current_match = registration.current_draw_match %>
          <% completed_matches = registration.completed_draw_matches %>
          <% medal = registration.medal_label %>
          <article class="athlete-event-row">
            <div class="athlete-event-main">
              <strong><%= registration.tournament.name %></strong>
              <span><%= registration.tournament_category.name %></span>
            </div>
            <div class="athlete-event-meta">
              <span>Tournament date</span>
              <strong><%= registration.tournament.start_date.strftime("%d %b %Y") %></strong>
            </div>
            <div class="athlete-event-notes">
              <% if registration.athlete_status_detail.present? %>
                <span><%= registration.athlete_status_detail %></span>
              <% end %>
              <% registration.weight_check_summary.each do |attempt| %>
                <span><%= attempt %></span>
              <% end %>
              <% if registration.active_tournament_draw.present? && registration.draw_status_label != "Draw set" %>
                <span><%= medal ? "#{medal} medal" : registration.draw_status_label %></span>
              <% end %>
              <% if registration.draw_status_detail.present? %>
                <span><%= registration.draw_status_detail %></span>
              <% end %>
              <% if current_match.present? %>
                <% color = registration.draw_head_guard_color(current_match) %>
                <span><%= current_match.round_label %> · Match <%= current_match.position %> · <%= color.to_s.titleize %></span>
              <% end %>
              <% completed_matches.each do |match| %>
                <% athlete_is_red = match.red_registration_id == registration.id %>
                <% athlete_points = athlete_is_red ? match.red_total_points : match.blue_total_points %>
                <% opponent_points = athlete_is_red ? match.blue_total_points : match.red_total_points %>
                <% athlete_sets = athlete_is_red ? match.red_round_wins : match.blue_round_wins %>
                <% opponent_sets = athlete_is_red ? match.blue_round_wins : match.red_round_wins %>
                <% athlete_color = athlete_is_red ? match.top_chest_guard_color : match.bottom_chest_guard_color %>
                <span><%= match.round_label %> · Match <%= match.position %> · <%= match.bye? ? "Bye" : "Sets #{athlete_sets} - #{opponent_sets}, #{athlete_points} - #{opponent_points}" %> · <%= athlete_color.titleize %> · <%= match.result_label_for(registration) %></span>
              <% end %>
            </div>
            <% unless registration.approved? %>
              <span class="status-pill status-<%= registration.status %>"><%= registration.athlete_status_label %></span>
            <% end %>
          </article>
        <% end %>
      <% else %>
        <div class="athlete-event-empty">
          <div><strong>No upcoming tournaments yet</strong><span>Find an open tournament and submit your registration.</span></div>
        </div>
      <% end %>
    </div>
  </div>
  <div class="section-compact">
    <h2 class="section-title">Previous competitions</h2>
    <div class="athlete-event-table">
      <% if @previous_registrations.any? %>
        <% @previous_registrations.each do |registration| %>
          <% current_match = registration.current_draw_match %>
          <% completed_matches = registration.completed_draw_matches %>
          <% medal = registration.medal_label %>
          <article class="athlete-event-row">
            <div class="athlete-event-main">
              <strong><%= registration.tournament.name %></strong>
              <span><%= registration.tournament_category.name %></span>
            </div>
            <div class="athlete-event-meta">
              <span>Tournament date</span>
              <strong><%= registration.tournament.start_date.strftime("%d %b %Y") %></strong>
            </div>
            <div class="athlete-event-notes">
              <% if registration.athlete_status_detail.present? %>
                <span><%= registration.athlete_status_detail %></span>
              <% end %>
              <% if registration.active_tournament_draw.present? && registration.draw_status_label != "Draw set" %>
                <span><%= medal ? "#{medal} medal" : registration.draw_status_label %></span>
              <% end %>
              <% if registration.draw_status_detail.present? %>
                <span><%= registration.draw_status_detail %></span>
              <% end %>
              <% if current_match.present? %>
                <% color = registration.draw_head_guard_color(current_match) %>
                <span><%= current_match.round_label %> · Match <%= current_match.position %> · <%= color.to_s.titleize %></span>
              <% end %>
              <% completed_matches.each do |match| %>
                <% athlete_is_red = match.red_registration_id == registration.id %>
                <% athlete_points = athlete_is_red ? match.red_total_points : match.blue_total_points %>
                <% opponent_points = athlete_is_red ? match.blue_total_points : match.red_total_points %>
                <% athlete_sets = athlete_is_red ? match.red_round_wins : match.blue_round_wins %>
                <% opponent_sets = athlete_is_red ? match.blue_round_wins : match.red_round_wins %>
                <% athlete_color = athlete_is_red ? match.top_chest_guard_color : match.bottom_chest_guard_color %>
                <span><%= match.round_label %> · Match <%= match.position %> · <%= match.bye? ? "Bye" : "Sets #{athlete_sets} - #{opponent_sets}, #{athlete_points} - #{opponent_points}" %> · <%= athlete_color.titleize %> · <%= match.result_label_for(registration) %></span>
              <% end %>
            </div>
            <% unless registration.approved? %>
              <span class="status-pill status-<%= registration.status %>"><%= registration.athlete_status_label %></span>
            <% end %>
          </article>
        <% end %>
      <% else %>
        <div class="athlete-event-empty">
          <div><strong>No previous competitions yet</strong><span>Completed tournaments will appear here.</span></div>
        </div>
      <% end %>
    </div>
  </div>
</div></section>

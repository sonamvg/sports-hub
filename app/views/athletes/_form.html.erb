<%= form_with model: athlete, class: "form-card" do |form| %>
  <%= render "shared/errors", record: athlete %>
  <%= hidden_field_tag :return_to, @return_to if @return_to.present? %>
  <% athlete_self_service = current_user.athlete? %>
  <div class="form-grid two-col">
    <div class="form-section-heading full"><h2>Personal details</h2></div>
    <% if current_user.academy_owner? && athlete.new_record? %>
      <div class="full">
        <%= form.label :account_email, "Athlete email" %>
        <%= form.email_field :account_email, required: true, autocomplete: "email" %>
        <%= field_error(athlete, :account_email) %>
        <p class="field-hint">This creates the athlete's own sign-in account. The email must not already be used in PodiumCircle.</p>
      </div>
    <% end %>
    <div><%= form.label :first_name %><%= form.text_field :first_name, required: true %><%= field_error(athlete, :first_name) %></div>
    <div><%= form.label :last_name %><%= form.text_field :last_name, required: true %><%= field_error(athlete, :last_name) %></div>
    <div><%= form.label :date_of_birth %><%= form.date_field :date_of_birth, required: true %><%= field_error(athlete, :date_of_birth) %></div>
    <div><%= form.label :gender %><%= form.select :gender, Athlete::GENDERS.map { |gender| [gender.titleize, gender] }, include_blank: "Select gender" %><%= field_error(athlete, :gender) %></div>
    <div><%= form.label :belt %><%= form.select :belt, Athlete::BELTS.map { |belt| [belt.titleize, belt] }, include_blank: "Select belt" %><%= field_error(athlete, :belt) %></div>
    <div><%= form.label :weight, "Current weight (kg)" %><%= form.number_field :weight, step: 0.1, min: 1 %><%= field_error(athlete, :weight) %></div>
    <div><%= form.label :blood_group %><%= form.select :blood_group, Athlete::BLOOD_GROUPS, include_blank: "Select blood group" %><%= field_error(athlete, :blood_group) %></div>
    <div><%= form.label :contact_number, "Contact number" %><%= form.telephone_field :contact_number %><%= field_error(athlete, :contact_number) %></div>
    <% if athlete_self_service %>
      <%
        pending_academy_request = athlete.pending_academy_request
        selected_academy_choice = athlete.external_academy_name.present? ? "other" : pending_academy_request&.academy_id || athlete.academy_id
        academy_options = @available_academies.map { |academy| [academy.name, academy.id] } + [["Other", "other"]]
      %>
      <div class="full">
        <%= form.label :academy_id, "Academy" %>
        <%= form.select :academy_id, options_for_select(academy_options, selected_academy_choice), { include_blank: "Select academy" }, data: { academy_choice_select: true } %>
        <%= field_error(athlete, :academy) %>
        <% if pending_academy_request %>
          <p class="field-hint">Join request pending with <%= pending_academy_request.academy.name %>.</p>
        <% else %>
          <p class="field-hint">A request will be sent to the academy owner for approval.</p>
        <% end %>
      </div>
      <div class="full" data-academy-other-field <%= "hidden" unless selected_academy_choice == "other" %>>
        <%= form.label :external_academy_name, "Academy name" %>
        <%= form.text_field :external_academy_name, placeholder: "Enter academy name", data: { academy_other_input: true }, disabled: selected_academy_choice != "other" %>
        <%= field_error(athlete, :external_academy_name) %>
        <p class="field-hint">If your academy is not already registered, please enter its name above.</p>
      </div>
    <% else %>
      <div class="full">
        <%= form.label :academy_id, "Approved academy" %>
        <%= form.collection_select :academy_id, @available_academies, :id, :name, include_blank: "No registered academy" %>
        <%= field_error(athlete, :academy) %>
      </div>
      <div class="full">
        <%= form.label :external_academy_name, "Academy not in PodiumCircle" %>
        <%= form.text_field :external_academy_name, placeholder: "Enter academy name if it is not registered here" %>
        <%= field_error(athlete, :external_academy_name) %>
        <p class="field-hint">Use this only when the academy is not listed above. It will be shown as plain text without an academy link.</p>
      </div>
      <div>
        <%= form.label :association_id, "Association ID" %>
        <%= form.text_field :association_id %>
        <%= field_error(athlete, :association_id) %>
      </div>
      <% end %>
    <div class="form-section-heading full"><h2>Address</h2></div>
    <div class="full"><%= form.label :address, "Address" %><%= form.text_area :address, rows: 3 %><%= field_error(athlete, :address) %></div>
    <div><%= form.label :city %><%= form.text_field :city %><%= field_error(athlete, :city) %></div>
    <div><%= form.label :state %><%= form.text_field :state %><%= field_error(athlete, :state) %></div>
    <div><%= form.label :country %><%= form.text_field :country, value: athlete.country.presence || "India" %><%= field_error(athlete, :country) %></div>
    <div class="form-section-heading full">
      <h2>Emergency and documents</h2>
      <p class="field-hint">A contact number and a government ID upload are required before this athlete can register for a tournament.</p>
    </div>
    <div><%= form.label :emergency_contact_name %><%= form.text_field :emergency_contact_name %><%= field_error(athlete, :emergency_contact_name) %></div>
    <div><%= form.label :emergency_contact_phone %><%= form.telephone_field :emergency_contact_phone %><%= field_error(athlete, :emergency_contact_phone) %></div>
    <div class="full">
      <%= form.label :profile_photo, "Athlete photo" %>
      <%= form.file_field :profile_photo, accept: "image/png,image/jpeg" %>
      <%= field_error(athlete, :profile_photo) %>
      <p class="field-hint">Accepted: JPG or PNG, up to 5 MB.</p>
    </div>
    <div class="full">
      <fieldset class="checkbox-fieldset">
        <legend>Government ID document type</legend>
        <% Athlete::GOVERNMENT_ID_DOCUMENT_TYPES.each do |document_type| %>
          <label class="checkbox-option">
            <%= form.radio_button :government_id_document_type, document_type %>
            <span><%= document_type %></span>
          </label>
        <% end %>
      </fieldset>
      <%= field_error(athlete, :government_id_document_type) %>
    </div>
    <div class="full">
      <%= form.label :identity_document, "Upload government ID document" %>
      <%= form.file_field :identity_document, accept: "image/png,image/jpeg" %>
      <%= field_error(athlete, :identity_document) %>
      <p class="field-hint">Accepted: JPG or PNG, up to 5 MB.</p>
    </div>
    <% if athlete.new_record? %>
      <div class="full consent-panel">
        <label class="checkbox-option">
          <%= form.check_box :terms_accepted, required: true %>
          <span>I accept the <%= link_to "PodiumCircle terms and conditions", terms_path, class: "text-link", target: "_blank", rel: "noopener" %>.</span>
        </label>
        <%= field_error(athlete, :terms_accepted) %>

        <label class="checkbox-option">
          <%= form.check_box :data_sharing_consent, required: true %>
          <span>I consent to sharing my athlete profile, academy details, documents, tournament registrations, payment receipt, weigh-in status, and results with my academy, tournament organisers, and authorised PodiumCircle admins for event operations.</span>
        </label>
        <%= field_error(athlete, :data_sharing_consent) %>
      </div>
    <% end %>
  </div>
  <div class="form-actions"><%= form.submit class: "primary-button button-reset" %><%= link_to "Cancel", @return_to.presence || athletes_path, class: "secondary-button" %></div>
<% end %>

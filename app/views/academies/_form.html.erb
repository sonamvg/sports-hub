<%= form_with model: academy, class: "form-card" do |form| %>
  <%= render "shared/errors", record: academy %>
  <% unless academy.approved? %>
    <div class="inline-empty-state">
      <strong>Add your academy profile</strong>
      <p>Once the academy is approved, you can add athletes and manage academy profile.</p>
    </div>
  <% end %>
  <div class="form-grid two-col">
    <div class="full"><%= form.label :name %><%= form.text_field :name, required: true %><%= field_error(academy, :name) %></div>
    <div><%= form.label :registration_number %><%= form.text_field :registration_number %><%= field_error(academy, :registration_number) %></div>
    <div><%= form.label :contact_name %><%= form.text_field :contact_name %><%= field_error(academy, :contact_name) %></div>
    <div><%= form.label :city %><%= form.text_field :city, required: true %><%= field_error(academy, :city) %></div>
    <div><%= form.label :state %><%= form.text_field :state %><%= field_error(academy, :state) %></div>
    <div><%= form.label :country %><%= form.text_field :country, value: academy.country.presence || "India" %><%= field_error(academy, :country) %></div>
    <div><%= form.label :phone %><%= form.telephone_field :phone %><%= field_error(academy, :phone) %></div>
    <div class="full"><%= form.label :email %><%= form.email_field :email %><%= field_error(academy, :email) %></div>
    <div class="full">
      <%= form.label :logo_image, "Academy logo" %>
      <%= form.file_field :logo_image, accept: "image/png,image/jpeg" %>
      <%= field_error(academy, :logo_image) %>
      <p class="field-hint">File size should be less than 5 MB and PNG/JPG is accepted.</p>
      <% if academy.logo_image.attached? %>
        <p class="field-hint">Current upload: <%= academy.logo_image.filename %></p>
      <% end %>
    </div>
  </div>
  <div class="form-actions"><%= form.submit class: "primary-button button-reset" %><%= link_to "Cancel", academies_path, class: "secondary-button" %></div>
<% end %>

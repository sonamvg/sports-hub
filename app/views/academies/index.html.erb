<section class="page-shell"><div class="container">
  <div class="page-heading"><div><p class="eyebrow">ACADEMIES</p><h1 class="page-title">Sports academies</h1><p class="page-copy">Public visitors can browse approved academies. Academy owners can submit their academy for super admin approval.</p></div><%= link_to "Register academy", new_academy_path, class: "primary-button" %></div>
  <div class="list-grid"><% @academies.each do |academy| %><article class="entity-card"><span class="status-pill status-<%= academy.status %>"><%= academy.status.humanize %></span><h2><%= academy.name %></h2><p><%= [academy.city, academy.state].compact.join(", ") %></p><p class="muted"><%= pluralize(academy.athletes.count, "athlete") %></p><%= link_to "View academy →", academy_path(academy), class: "text-link" %></article><% end %></div>
</div></section>

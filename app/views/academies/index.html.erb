<section class="page-shell"><div class="container">
  <%= render "shared/breadcrumbs", items: [
    { label: "Home", path: root_path },
    { label: "Academies" }
  ] %>

  <div class="page-heading"><div><p class="eyebrow">ACADEMIES</p><h1 class="page-title">Sports academies</h1><p class="page-copy">Browse approved academies and verified training centres.</p></div><% if current_user.nil? || current_user.academy_owner? || super_admin? %><%= link_to new_academy_path, class: "primary-button icon-label" do %><%= ui_icon("plus") %><span>Register academy</span><% end %><% end %></div>
  <%= form_with url: academies_path, method: :get, class: "filter-bar compact-filter" do |form| %>
    <div><%= form.label :q do %><%= ui_icon("search") %><span>Search academies</span><% end %><%= form.search_field :q, value: params[:q], placeholder: "Name, city, state, country" %></div>
    <div class="filter-actions"><%= button_tag type: "submit", class: "primary-button button-reset icon-label" do %><%= ui_icon("search") %><span>Search</span><% end %><%= link_to "Clear", academies_path, class: "secondary-button" %></div>
  <% end %>
  <% if current_user&.academy_owner? %>
    <div class="section-compact">
      <h2 class="section-title">My academies</h2>
      <% if @my_academies.any? %>
        <div class="list-grid">
          <% @my_academies.each do |academy| %>
            <%= render "academy_card", academy: academy %>
          <% end %>
        </div>
      <% else %>
        <p class="muted">No academies registered yet.</p>
      <% end %>
    </div>
    <div class="section-compact">
      <h2 class="section-title">Other academies</h2>
    </div>
  <% end %>
  <div class="list-grid">
    <% @academies.each do |academy| %>
      <%= render "academy_card", academy: academy %>
    <% end %>
  </div>
  <%= render "shared/pagination", pagination: @pagination %>
</div></section>

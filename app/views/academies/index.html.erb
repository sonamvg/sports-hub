<section class="page-shell"><div class="container">
  <div class="page-heading"><div><p class="eyebrow">ACADEMIES</p><h1 class="page-title">Sports academies</h1><p class="page-copy">Public visitors can browse approved academies. Academy owners can submit their academy for super admin approval.</p></div><%= link_to "Register academy", new_academy_path, class: "primary-button" %></div>
  <%= form_with url: academies_path, method: :get, class: "filter-bar compact-filter" do |form| %>
    <div><%= form.label :q, "Search academies" %><%= form.search_field :q, value: params[:q], placeholder: "Name, city, state, country" %></div>
    <div class="filter-actions"><%= form.submit "Search", class: "primary-button button-reset" %><%= link_to "Clear", academies_path, class: "secondary-button" %></div>
  <% end %>
  <div class="list-grid"><% @academies.each do |academy| %><article class="entity-card"><span class="status-pill status-<%= academy.status %>"><%= academy.status.humanize %></span><h2><%= academy.name %></h2><p><%= [academy.city, academy.state].compact.join(", ") %></p><% if can_manage_academy?(academy) %><p class="muted"><%= pluralize(academy.athletes.count, "athlete") %></p><% end %><%= link_to "View academy →", academy_path(academy), class: "text-link" %></article><% end %></div>
  <%= render "shared/pagination", pagination: @pagination %>
</div></section>

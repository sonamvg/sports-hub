<section class="page-shell"><div class="container narrow">
<%= render "shared/breadcrumbs", items: [
  { label: "Home", path: root_path },
  { label: "Academies", path: academies_path },
  { label: @academy.name }
] %>

<div class="academy-show-header">
  <div class="academy-show-identity">
    <div class="academy-show-logo">
      <%= image_with_placeholder(
        @academy.logo_image.attached? ? @academy.logo_image : nil,
        alt: "#{@academy.name} logo",
        placeholder: @academy.name.to_s.first&.upcase || "A"
      ) %>
    </div>
    <div>
      <p class="eyebrow">ACADEMY</p>
      <h1 class="page-title"><%= @academy.name %></h1>
      <p class="page-copy"><%= [@academy.city, @academy.state, @academy.country].compact_blank.join(", ").presence || "Location not set" %></p>
    </div>
  </div>

  <details class="kebab-menu academy-show-menu">
    <summary aria-label="Actions for <%= @academy.name %>"><%= ui_icon("more-vertical") %></summary>
    <div class="kebab-menu-panel">
      <%= link_to academies_path, class: "kebab-menu-item" do %>
        <%= ui_icon("academy") %><span>All academies</span>
      <% end %>
      <% if can_manage_academy?(@academy) %>
        <%= link_to edit_academy_path(@academy), class: "kebab-menu-item" do %>
          <%= ui_icon("edit") %><span>Edit academy</span>
        <% end %>
        <% if @academy.approved? %>
          <%= link_to new_athlete_path(academy_id: @academy.id), class: "kebab-menu-item" do %>
            <%= ui_icon("medal") %><span>Add athlete</span>
          <% end %>
        <% end %>
        <%= link_to athletes_academy_path(@academy), class: "kebab-menu-item" do %>
          <%= ui_icon("medal") %><span>My athletes</span>
        <% end %>
        <%= link_to notifications_academy_path(@academy), class: "kebab-menu-item" do %>
          <%= ui_icon("user") %><span>Notifications</span>
        <% end %>
      <% end %>
      <% if super_admin? && @academy.pending? %>
        <%= button_to approve_academy_path(@academy), method: :patch, class: "kebab-menu-item" do %>
          <%= ui_icon("shield") %><span>Approve academy</span>
        <% end %>
        <%= button_to reject_academy_path(@academy), method: :patch, class: "kebab-menu-item kebab-menu-danger" do %>
          <%= ui_icon("trash") %><span>Reject academy</span>
        <% end %>
      <% end %>
      <% if super_admin? %>
        <%= button_to academy_path(@academy), method: :delete, class: "kebab-menu-item kebab-menu-danger", form: { data: { turbo_confirm: "Delete #{@academy.name}?" } } do %>
          <%= ui_icon("trash") %><span>Delete academy</span>
        <% end %>
      <% end %>
    </div>
  </details>
</div>

<div class="detail-card">
  <span class="status-pill status-<%= @academy.status %>"><%= @academy.status.humanize %></span>
  <section class="academy-contact-panel" aria-labelledby="academy-contact-heading">
    <h2 id="academy-contact-heading">Contact details</h2>
    <div class="academy-contact-grid">
      <div><span>Contact person</span><strong><%= @academy.contact_name.presence || @academy.owner&.name || "--" %></strong></div>
      <div><span>Email</span><strong><%= @academy.email.present? ? mail_to(@academy.email) : "--" %></strong></div>
      <div><span>Phone</span><strong><%= @academy.phone.presence || "--" %></strong></div>
      <div><span>Owner</span><strong><%= @academy.owner&.name || "--" %></strong></div>
    </div>
  </section>
  <% if @academy.rejected? && @academy.rejection_reason.present? %>
    <dl class="detail-list"><div><dt>Reason</dt><dd><%= @academy.rejection_reason %></dd></div></dl>
  <% end %>
  <% if can_manage_academy?(@academy) %>
    <section class="academy-management-panel" aria-label="Academy management">
      <%= link_to athletes_academy_path(@academy), class: "academy-management-card" do %>
        <span><%= ui_icon("medal") %></span>
        <strong>My athletes</strong>
        <small>View roster and tournament status</small>
      <% end %>
      <%= link_to notifications_academy_path(@academy), class: "academy-management-card" do %>
        <span><%= ui_icon("user") %></span>
        <strong>Notifications</strong>
        <small>Review academy join requests</small>
      <% end %>
    </section>
  <% end %>
</div></div></section>

<section class="page-shell"><div class="container narrow">
<%= render "shared/breadcrumbs", items: [
  { label: "Home", path: root_path },
  { label: "Tournaments", path: tournaments_path },
  { label: @tournament.name, path: tournament_path(@tournament) },
  { label: "Register", path: new_tournament_registration_path(@tournament) },
  { label: "Pair / Team Poomsae" }
] %>

<p class="eyebrow">REGISTER A PAIR OR TEAM POOMSAE ENTRY</p>
<h1 class="page-title"><%= @tournament.name %></h1>
<p class="page-copy">Every teammate is chosen up front here, so it's kept separate from individual categories. Add each team, then move on to the next one.</p>

<div class="registration-nav-links">
  <%= link_to individual_tournament_registrations_path(@tournament), class: "text-link icon-label" do %><%= ui_icon("arrow-right", class: "icon-flip") %><span>Back to individual categories</span><% end %>
  <%= link_to payment_tournament_registrations_path(@tournament), class: "text-link icon-label" do %><span>Proceed to payment</span><%= ui_icon("arrow-right") %><% end %>
</div>

<% if @error %>
  <div class="inline-notice inline-notice-warning"><%= @error %></div>
<% end %>

<div class="form-card">
  <div style="display:flex; gap:12px;">
    <%= link_to group_tournament_registrations_path(@tournament, team_type: "pair_poomsae"), class: "team-type-option #{"selected" if @team_type == "pair_poomsae"}" do %>
      <div><strong>Pair Poomsae</strong><div class="field-hint" style="margin:2px 0 0;">2 athletes, same academy</div></div>
    <% end %>
    <%= link_to group_tournament_registrations_path(@tournament, team_type: "team_poomsae"), class: "team-type-option #{"selected" if @team_type == "team_poomsae"}" do %>
      <div><strong>Team Poomsae</strong><div class="field-hint" style="margin:2px 0 0;">3 athletes, same academy</div></div>
    <% end %>
  </div>

  <%= form_with url: group_tournament_registrations_path(@tournament), method: :post, class: "form-grid", style: "margin-top:22px;" do |form| %>
    <%= hidden_field_tag :team_type, @team_type %>
    <%= hidden_field_tag :next, "group" %>

    <div>
      <label>Category</label>
      <%= select_tag :tournament_category_id, options_from_collection_for_select(@group_categories, :id, :name), include_blank: "Choose category" %>
    </div>

    <% required_count = @team_type == "team_poomsae" ? 3 : 2 %>
    <div data-team-athlete-picker>
      <label>Teammates (<%= required_count %> required, same academy)</label>
      <% (1..required_count).each do |slot| %>
        <%= select_tag "athlete_ids[]", options_from_collection_for_select(@athletes, :id, :full_name), include_blank: "Choose team member #{slot}", style: "margin-bottom:8px;", data: { team_member_select: true } %>
      <% end %>
      <p class="field-hint"><%= link_to "+ Register new athlete", new_athlete_path(return_to: request.fullpath), class: "text-link" %></p>
    </div>

    <div class="form-actions full">
      <%= button_tag "Add to registration", type: "submit", class: "primary-button button-reset" %>
    </div>
  <% end %>
</div>

<% if @draft_registrations.any? %>
  <div class="cart-strip-heading" style="margin-top:32px;">
    <strong>Already in this registration &middot; <%= @draft_registrations.map(&:submission_batch_id).uniq.size %></strong>
  </div>
  <%= render "registrations/draft_cart_rows", grouped_rows: @draft_registrations.group_by(&:submission_batch_id) %>
<% end %>
</div></section>

<script>
  document.addEventListener("change", function(event) {
    if (!event.target.closest("[data-team-member-select]")) return;
    updateTeamMemberOptions(event.target.closest("[data-team-athlete-picker]"));
  });

  document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll("[data-team-athlete-picker]").forEach(updateTeamMemberOptions);
  });

  function updateTeamMemberOptions(picker) {
    if (!picker) return;

    const selects = Array.from(picker.querySelectorAll("[data-team-member-select]"));
    const chosen = selects.map(function(select) { return select.value; }).filter(Boolean);

    selects.forEach(function(select) {
      Array.from(select.options).forEach(function(option) {
        if (!option.value) return;
        option.disabled = chosen.includes(option.value) && select.value !== option.value;
      });
    });
  }
</script>

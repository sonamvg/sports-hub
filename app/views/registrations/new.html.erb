<section class="page-shell"><div class="container narrow">
<%= render "shared/breadcrumbs", items: [
  { label: "Home", path: root_path },
  { label: "Tournaments", path: tournaments_path },
  { label: @tournament.name, path: tournament_path(@tournament) },
  { label: "Registrations", path: tournament_registrations_path(@tournament) },
  { label: "New" }
] %>

<p class="eyebrow">REGISTRATION</p><h1 class="page-title">Register for <%= @tournament.name %></h1><p class="page-copy">Choose an athlete and one or more categories. You can save the selection and return after making payment.</p>
<% if @tournament.registration_closed_for_weight_check? && @tournament.late_registration_allowed_for?(current_user) %>
  <div class="inline-notice">Registration is closed. As super organiser, you can manually add athletes until draw setup starts.</div>
<% end %>
<%= form_with model: [@tournament, @registration], class: "form-card" do |form| %>
  <%= render "shared/errors", record: @registration %>
  <% if @athletes.empty? %>
    <div class="inline-empty-state">
      <strong>No athlete profiles yet</strong>
      <p>Add an athlete profile first, then come back here to finish the registration.</p>
      <%= link_to "Add athlete", new_athlete_path(return_to: request.fullpath), class: "primary-button" %>
    </div>
  <% end %>
  <div class="form-grid">
    <div>
      <%= form.label :athlete_id, "Athlete" %>
      <%= form.collection_select :athlete_id, @athletes, :id, :full_name, prompt: "Choose athlete" %>
      <% if @athletes.any? %>
        <p class="field-hint"><%= link_to "Add another athlete", new_athlete_path(return_to: request.fullpath), class: "text-link" %></p>
      <% end %>
    </div>
    <div class="full">
      <%= form.label :tournament_category_ids, "Categories" %>
      <div class="category-picker" data-category-picker>
        <% category_choices = @categories.map { |category| ["#{category.name} - #{category.fee_label}", category.id, { data: { fee: category.effective_registration_fee.to_s } }] } %>
        <% selected_rows = @selected_category_ids.presence || [""] %>
        <% selected_rows.each_with_index do |category_id, index| %>
          <div class="category-picker-row" data-category-row>
            <%= select_tag "registration[tournament_category_ids][]", options_for_select(category_choices, category_id), include_blank: "Choose category", class: "category-picker-select", data: { category_select: true } %>
            <button type="button" class="secondary-button button-reset category-remove-button" data-remove-category <%= "hidden" if category_id.blank? && selected_rows.one? %>>Delete</button>
          </div>
        <% end %>
        <template data-category-template>
          <div class="category-picker-row" data-category-row>
            <%= select_tag "registration[tournament_category_ids][]", options_for_select(category_choices), include_blank: "Choose category", class: "category-picker-select", data: { category_select: true } %>
            <button type="button" class="secondary-button button-reset category-remove-button" data-remove-category>Delete</button>
          </div>
        </template>
        <label class="checkbox-option add-more-category-option" data-add-more-wrapper <%= "hidden" if @selected_category_ids.blank? %>>
          <input type="checkbox" data-add-more-category>
          <span>Do you want to add more categories?</span>
        </label>
      </div>
      <p class="field-hint">Select every category this athlete wants to enter. Saved drafts are preselected when you return.</p>
    </div>
    <div class="registration-total full" data-registration-total data-currency="<%= @tournament.currency.presence || "INR" %>">
      <strong>Total amount to pay</strong>
      <span data-total-amount><%= @tournament.currency.presence || "INR" %> 0</span>
      <p class="field-hint">The total updates from selected category fees.</p>
    </div>
    <div><%= form.label :registered_weight, "Current weight (kg)" %><%= form.number_field :registered_weight, step: 0.1, min: 1 %></div>
    <div class="full payment-instructions">
      <h2>Secure payment details</h2>
      <p class="field-hint">These bank details are shown only in this signed-in registration flow and are not displayed on public tournament pages.</p>
      <dl>
        <div><dt>Account holder</dt><dd><%= @tournament.payment_account_name || "--" %></dd></div>
        <div><dt>Bank</dt><dd><%= @tournament.payment_bank_name || "--" %></dd></div>
        <div><dt>Account number</dt><dd><%= @tournament.payment_account_number || "--" %></dd></div>
        <div><dt>IFSC</dt><dd><%= @tournament.payment_ifsc || "--" %></dd></div>
      </dl>
      <p><%= @tournament.payment_instructions.presence || "Make the payment using the organizer's shared instructions, then upload the receipt before submitting." %></p>
      <p class="field-hint">Use payment description: <strong><%= "#{@tournament.name} - #{@registration.athlete&.full_name || "Athlete name"}" %></strong></p>
    </div>
    <div>
      <%= form.label :payment_receipt, "Payment receipt photo" %>
      <%= form.file_field :payment_receipt, accept: "image/png,image/jpeg,image/webp,application/pdf" %>
      <p class="field-hint">Required when submitting. Upload a receipt image or PDF so organizers can verify payment before accepting the registration.</p>
    </div>
  </div>
  <div class="form-actions">
    <%= form.submit "Save and pay later", class: "secondary-button button-reset", formnovalidate: true %>
    <%= form.submit "Submit registration", class: "primary-button button-reset" %>
    <%= link_to "Cancel", tournament_path(@tournament), class: "secondary-button" %>
  </div>
<% end %>
</div></section>

<script>
  document.addEventListener("change", function(event) {
    const select = event.target.closest("[data-category-select]");
    if (!select) return;

    const picker = select.closest("[data-category-picker]");
    const addMoreWrapper = picker.querySelector("[data-add-more-wrapper]");
    addMoreWrapper.hidden = picker.querySelectorAll("[data-category-select]").length > 0 && select.value === "";
    if (select.value !== "") addMoreWrapper.hidden = false;
  });

  document.addEventListener("change", function(event) {
    const checkbox = event.target.closest("[data-add-more-category]");
    if (!checkbox || !checkbox.checked) return;

    const picker = checkbox.closest("[data-category-picker]");
    const template = picker.querySelector("[data-category-template]");
    picker.insertBefore(template.content.cloneNode(true), checkbox.closest("[data-add-more-wrapper]"));
    checkbox.checked = false;
    checkbox.closest("[data-add-more-wrapper]").hidden = true;
  });

  document.addEventListener("click", function(event) {
    const button = event.target.closest("[data-remove-category]");
    if (!button) return;

    const picker = button.closest("[data-category-picker]");
    const rows = picker.querySelectorAll("[data-category-row]");
    if (rows.length === 1) {
      rows[0].querySelector("select").value = "";
      button.hidden = true;
      picker.querySelector("[data-add-more-wrapper]").hidden = true;
    } else {
      button.closest("[data-category-row]").remove();
    }
    updateRegistrationTotal(picker);
  });

  document.addEventListener("change", function(event) {
    const picker = event.target.closest("[data-category-picker]");
    if (picker) updateRegistrationTotal(picker);
  });

  document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll("[data-category-picker]").forEach(updateRegistrationTotal);
  });

  function updateRegistrationTotal(picker) {
    if (!picker) return;

    const totalBox = document.querySelector("[data-registration-total]");
    const totalAmount = document.querySelector("[data-total-amount]");
    const currency = totalBox.dataset.currency || "INR";
    const total = Array.from(picker.querySelectorAll("[data-category-select]")).reduce(function(sum, select) {
      const option = select.selectedOptions[0];
      return sum + Number(option && option.dataset.fee ? option.dataset.fee : 0);
    }, 0);

    totalAmount.textContent = currency + " " + new Intl.NumberFormat("en-IN", { maximumFractionDigits: 2 }).format(total);
  }
</script>

<section class="page-shell"><div class="container narrow">
<%= render "shared/breadcrumbs", items: [
  { label: "Home", path: root_path },
  { label: "Tournaments", path: tournaments_path },
  { label: @tournament.name, path: tournament_path(@tournament) },
  { label: "Registrations", path: tournament_registrations_path(@tournament) },
  { label: "New" }
] %>

<p class="eyebrow">REGISTER FOR THIS TOURNAMENT</p>
<h1 class="page-title"><%= @tournament.name %></h1>
<p class="page-copy">Choose how you want to register today. Add the other type from either screen before you pay &mdash; one payment covers everything.</p>

<div class="mode-grid">
  <%= link_to individual_tournament_registrations_path(@tournament), class: "mode-card" do %>
    <h3>Register for individual categories</h3>
    <p>Pick the athlete, then choose from Kyorugi and Individual Poomsae categories suggested for them &mdash; add more than one if they're entering several.</p>
    <span class="text-link">Start &rarr;</span>
  <% end %>

  <%= link_to group_tournament_registrations_path(@tournament), class: "mode-card" do %>
    <h3>Register a Pair or Team Poomsae entry</h3>
    <p>Choose Pair (2 athletes) or Team (3 athletes) first, then pick the teammates from your roster. One shared entry, one shared fee.</p>
    <span class="text-link">Start &rarr;</span>
  <% end %>
</div>
</div></section>

<div class="cart-strip">
  <% grouped_rows.each do |batch_id, rows| %>
    <% batch_total = Registration.total_fee(rows) %>
    <div class="cart-strip-row">
      <div class="cart-strip-row-main">
        <strong><%= rows.map { |r| r.athlete.full_name }.uniq.join(" & ") %></strong>
        <span><%= rows.map { |r| r.tournament_category.name }.uniq.join(", ") %></span>
        <span class="cart-strip-row-age<%= " cart-strip-row-stale" if rows.first.created_at < 24.hours.ago %>">Added <%= time_ago_in_words(rows.first.created_at) %> ago</span>
      </div>
      <div class="cart-strip-row-fee"><%= batch_total.zero? ? "Free" : "#{rows.first.fee_currency.presence || rows.first.tournament.currency.presence || "INR"} #{number_with_delimiter(batch_total.to_i)}" %></div>
      <%= button_to "Remove", tournament_registration_path(@tournament, rows.first), method: :delete, class: "text-link button-reset", form: { style: "display:inline;" } %>
    </div>
  <% end %>
</div>

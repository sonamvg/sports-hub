<section class="page-shell"><div class="container narrow">
<%= render "shared/breadcrumbs", items: [
  { label: "Home", path: root_path },
  { label: "Tournaments", path: tournaments_path },
  { label: @tournament.name, path: tournament_path(@tournament) },
  { label: "Register", path: new_tournament_registration_path(@tournament) },
  { label: "Individual" }
] %>

<p class="eyebrow">REGISTER FOR INDIVIDUAL CATEGORIES</p>
<h1 class="page-title"><%= @tournament.name %></h1>

<div class="registration-nav-links">
  <%= link_to group_tournament_registrations_path(@tournament), class: "text-link icon-label" do %><span>Register a Pair/Team Poomsae entry</span><%= ui_icon("arrow-right") %><% end %>
  <%= link_to payment_tournament_registrations_path(@tournament), class: "text-link icon-label" do %><span>Proceed to payment</span><%= ui_icon("arrow-right") %><% end %>
</div>

<% if @error %>
  <div class="inline-notice inline-notice-warning"><%= @error %></div>
<% end %>

<div class="form-card">
  <div class="form-grid two-col">
    <div>
      <label>Athlete</label>
      <div class="roster-list">
        <% @athletes.each do |athlete| %>
          <% added_count = @registration_counts_by_athlete[athlete.id].to_i %>
          <%= link_to individual_tournament_registrations_path(@tournament, athlete_id: athlete.id), class: "roster-row #{"selected" if @athlete == athlete}" do %>
            <div class="roster-radio"><% if @athlete == athlete %><div class="roster-radio-dot"></div><% end %></div>
            <div class="roster-row-main">
              <strong><%= athlete.full_name %></strong>
              <span><%= athlete.gender&.titleize %> &middot; <%= athlete.academy&.name || "No academy" %></span>
            </div>
            <% if added_count.positive? %>
              <span class="roster-row-added-pill"><%= added_count %> added</span>
            <% end %>
          <% end %>
        <% end %>
      </div>
      <p class="field-hint"><%= link_to "+ Register new athlete", new_athlete_path(return_to: request.fullpath), class: "text-link" %></p>

      <% if @athletes.empty? %>
        <div class="inline-empty-state">
          <strong>No athlete profiles yet</strong>
          <p>Register an athlete profile first, then come back here to finish the registration.</p>
        </div>
      <% end %>
    </div>

    <% if @athlete %>
      <div>
        <% unless @athlete.profile_complete_for_registration? %>
          <div class="inline-notice inline-notice-warning">
            <strong><%= @athlete.full_name %>&rsquo;s profile is incomplete.</strong>
            <span>Add a contact number to this athlete's profile before registering.</span>
            <%= link_to "Complete profile", edit_athlete_path(@athlete, return_to: request.fullpath), class: "primary-button" %>
          </div>
        <% end %>

        <%= form_with url: individual_tournament_registrations_path(@tournament), method: :post do |form| %>
          <%= hidden_field_tag :athlete_id, @athlete.id %>
          <%= hidden_field_tag :next, "individual" %>

          <label for="registered_weight">Registration weight (optional)</label>
          <%= number_field_tag :registered_weight, params[:registered_weight].presence || @athlete.weight, step: 0.1, min: 1, max: 300, placeholder: "e.g. 33.8", data: { profile_weight: @athlete.weight } %>
          <p class="field-hint">Defaults to the profile weight<%= " (#{@athlete.weight} kg)" if @athlete.weight.present? %>, just as a reference for organizers — weight often changes by tournament day, so you can pick any category below that matches the athlete's gender and age, regardless of this number. Actual weight is confirmed at weigh-in. The "closest" pick below updates as you change this.</p>

          <div style="margin-top:16px;">
            <label>Categories</label>
            <div class="category-picker <%= "category-picker-invalid" if @error %>" data-category-picker>
              <% kyorugi_options = @suggestions[:kyorugi].map do |category|
                base_label = "#{category.name} - #{category.fee_label}"
                is_closest = category == @suggestions[:recommended]
                [
                  is_closest ? "#{base_label} (closest)" : base_label,
                  category.id,
                  { data: { base_label: base_label, weight_min: category.weight_min, weight_max: category.weight_max } }
                ]
              end %>
              <% poomsae_options = @suggestions[:individual_poomsae].map { |category| ["#{category.name} - #{category.fee_label}", category.id] } %>
              <% grouped_choices = { "Kyorugi" => kyorugi_options, "Individual Poomsae" => poomsae_options } %>
              <% explicit_selection = @selected_category_ids.present? %>
              <% selected_rows = @selected_category_ids.presence || [@suggestions[:recommended]&.id&.to_s].compact.presence || [""] %>
              <% selected_rows.each do |category_id| %>
                <div class="category-picker-row" data-category-row>
                  <button type="button" class="category-remove-button" data-remove-category aria-label="Remove this category" <%= "hidden" if category_id.blank? && selected_rows.one? %>><%= ui_icon("x") %></button>
                  <select name="tournament_category_ids[]" class="category-picker-select" data-category-select <%= "data-user-selected=\"true\"".html_safe if explicit_selection && category_id.present? %>>
                    <option value="">Choose category</option>
                    <%= grouped_options_for_select(grouped_choices, category_id) %>
                  </select>
                </div>
              <% end %>
              <template data-category-template>
                <div class="category-picker-row" data-category-row>
                  <button type="button" class="category-remove-button" data-remove-category aria-label="Remove this category"><%= ui_icon("x") %></button>
                  <select name="tournament_category_ids[]" class="category-picker-select" data-category-select>
                    <option value="">Choose category</option>
                    <%= grouped_options_for_select(grouped_choices) %>
                  </select>
                </div>
              </template>
              <label class="checkbox-option add-more-category-option" data-add-more-wrapper>
                <input type="checkbox" data-add-more-category>
                <span>Do you want to add another category for this athlete?</span>
              </label>
            </div>
            <% if @suggestions[:kyorugi].empty? && @suggestions[:individual_poomsae].empty? %>
              <p class="field-hint">No individual categories match this athlete's gender and age in this tournament yet.</p>
            <% end %>
          </div>

          <div class="form-actions" style="margin-top:24px;">
            <%= button_tag "Add to registration", type: "submit", class: "primary-button button-reset" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<% if @draft_registrations.any? %>
  <div class="cart-strip-heading" style="margin-top:32px;">
    <strong>Already in this registration &middot; <%= @draft_registrations.map(&:submission_batch_id).uniq.size %></strong>
  </div>
  <%= render "registrations/draft_cart_rows", grouped_rows: @draft_registrations.group_by(&:submission_batch_id) %>
<% end %>
</div></section>

<script>
  document.addEventListener("change", function(event) {
    const select = event.target.closest("[data-category-select]");
    if (!select) return;
    // A real user pick — stop this row from following weight changes, so we
    // never silently override a category someone deliberately chose.
    select.dataset.userSelected = "true";
    updateAddMoreVisibility(select.closest("[data-category-picker]"));
  });

  document.addEventListener("change", function(event) {
    const checkbox = event.target.closest("[data-add-more-category]");
    if (!checkbox || !checkbox.checked) return;

    const picker = checkbox.closest("[data-category-picker]");
    const template = picker.querySelector("[data-category-template]");
    picker.insertBefore(template.content.cloneNode(true), checkbox.closest("[data-add-more-wrapper]"));
    checkbox.checked = false;
    updateAddMoreVisibility(picker);
    updateClosestCategoryOptions();
  });

  document.addEventListener("click", function(event) {
    const button = event.target.closest("[data-remove-category]");
    if (!button) return;

    const picker = button.closest("[data-category-picker]");
    const rows = picker.querySelectorAll("[data-category-row]");
    if (rows.length === 1) {
      const select = rows[0].querySelector("select");
      select.value = "";
      select.dataset.userSelected = "";
      button.hidden = true;
    } else {
      button.closest("[data-category-row]").remove();
    }
    updateAddMoreVisibility(picker);
    updateClosestCategoryOptions();
  });

  document.addEventListener("input", function(event) {
    if (event.target.id !== "registered_weight") return;
    updateClosestCategoryOptions();
  });

  document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll("[data-category-picker]").forEach(updateAddMoreVisibility);
    updateClosestCategoryOptions();
  });

  function updateAddMoreVisibility(picker) {
    if (!picker) return;
    const addMoreWrapper = picker.querySelector("[data-add-more-wrapper]");
    if (!addMoreWrapper) return;

    const selects = Array.from(picker.querySelectorAll("[data-category-select]"));
    const hasSelection = selects.some(function(select) { return select.value !== ""; });
    const hasBlankRow = selects.some(function(select) { return select.value === ""; });
    addMoreWrapper.hidden = !hasSelection || hasBlankRow;
  }

  // Preference order for which weight decides the "(closest)" Kyorugi
  // bracket: whatever's typed in the weight field right now, then the
  // profile weight it defaulted from, then no preference at all (every
  // matching bracket listed with none singled out).
  function effectiveRegistrationWeight() {
    const input = document.getElementById("registered_weight");
    if (!input) return null;

    const typed = parseFloat(input.value);
    if (input.value.trim() !== "" && !isNaN(typed)) return typed;

    const profileWeight = parseFloat(input.dataset.profileWeight);
    return isNaN(profileWeight) ? null : profileWeight;
  }

  function weightBracketOptions() {
    const live = Array.from(document.querySelectorAll("option[data-base-label]"));
    const template = document.querySelector("[data-category-template]");
    return template ? live.concat(Array.from(template.content.querySelectorAll("option[data-base-label]"))) : live;
  }

  function closestBracketValue(weight) {
    if (weight === null) return null;

    let closestValue = null;
    let closestDistance = Infinity;
    const seen = {};

    weightBracketOptions().forEach(function(option) {
      if (seen[option.value]) return;
      seen[option.value] = true;

      const bounds = [option.dataset.weightMin, option.dataset.weightMax].filter(function(value) { return value; }).map(parseFloat);
      if (bounds.length === 0) return;

      const midpoint = bounds.reduce(function(sum, value) { return sum + value; }, 0) / bounds.length;
      const distance = Math.abs(weight - midpoint);
      if (distance < closestDistance) {
        closestDistance = distance;
        closestValue = option.value;
      }
    });

    return closestValue;
  }

  function updateClosestCategoryOptions() {
    const closestValue = closestBracketValue(effectiveRegistrationWeight());

    weightBracketOptions().forEach(function(option) {
      const isClosest = closestValue !== null && option.value === closestValue;
      option.textContent = option.dataset.baseLabel + (isClosest ? " (closest)" : "");
    });

    if (closestValue === null) return;

    document.querySelectorAll("[data-category-select]").forEach(function(select) {
      if (select.dataset.userSelected === "true") return;
      if (!Array.from(select.options).some(function(option) { return option.value === closestValue; })) return;
      select.value = closestValue;
    });
  }
</script>

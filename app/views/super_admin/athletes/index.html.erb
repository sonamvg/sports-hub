<section class="page-shell"><div class="container">
  <%= render "shared/breadcrumbs", items: [
    { label: "Home", path: root_path },
    { label: "Super admin athletes" }
  ] %>

  <div class="page-heading compact-heading">
    <div>
      <p class="eyebrow">SUPER ADMIN</p>
      <h1 class="page-title">Athletes</h1>
      <p class="page-copy">View every athlete profile and remove records when needed.</p>
    </div>
    <span class="status-pill"><%= @total_count %> total</span>
  </div>

  <%= form_with url: super_admin_athletes_path, method: :get, class: "filter-bar" do |form| %>
    <div><%= form.label :q do %><%= ui_icon("search") %><span>Search</span><% end %><%= form.search_field :q, value: @query, placeholder: "Name, academy, association ID, or email" %></div>
    <div class="filter-actions"><%= button_tag type: "submit", class: "primary-button button-reset icon-label" do %><%= ui_icon("search") %><span>Search</span><% end %><%= link_to "Clear", super_admin_athletes_path, class: "secondary-button" %></div>
  <% end %>

  <% if @athletes.any? %>
    <div class="approval-table organizer-registration-table">
      <table>
        <thead>
          <tr>
            <th>Athlete</th>
            <th>Academy</th>
            <th>Contact</th>
            <th>Profile</th>
            <th class="table-actions-heading">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @athletes.each do |athlete| %>
            <tr>
              <td>
                <div class="tournament-status-athlete">
                  <span class="tournament-status-avatar">
                    <%= image_with_placeholder(
                      athlete.profile_photo_source,
                      alt: "#{athlete.full_name} photo",
                      placeholder: athlete.full_name.to_s.split.map(&:first).join.first(2).presence || "A"
                    ) %>
                  </span>
                  <div class="tournament-status-athlete-details">
                    <%= link_to athlete.full_name, athlete_path(athlete), class: "notification-athlete-link" %>
                    <span><%= [athlete.gender&.titleize, athlete.date_of_birth&.strftime("%d %b %Y")].compact_blank.join(" · ") %></span>
                  </div>
                </div>
              </td>
              <td><%= athlete.academy_display_name.presence || "--" %></td>
              <td><%= athlete.user.email %></td>
              <td><%= [athlete.belt&.titleize, athlete.weight ? "#{athlete.weight} kg" : nil].compact_blank.join(" · ").presence || "--" %></td>
              <td class="table-actions-cell">
                <details class="kebab-menu">
                  <summary aria-label="Actions for <%= athlete.full_name %>"><%= ui_icon("more-vertical") %></summary>
                  <div class="kebab-menu-panel">
                    <%= link_to athlete_path(athlete), class: "kebab-menu-item" do %>
                      <%= ui_icon("eye") %><span>View profile</span>
                    <% end %>
                    <%= button_to super_admin_athlete_path(athlete), method: :delete, class: "kebab-menu-item kebab-menu-danger", form: { data: { turbo_confirm: "Are you sure you want to delete #{athlete.full_name}?" } } do %>
                      <%= ui_icon("trash") %><span>Delete athlete</span>
                    <% end %>
                  </div>
                </details>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/pagination", pagination: @pagination %>
  <% else %>
    <div class="inline-empty-state">
      <strong>No athletes found</strong>
      <p><%= @query.present? ? "No athlete matches \"#{@query}\". Try a different search." : "Athlete profiles will appear here after users create them." %></p>
    </div>
  <% end %>
</div></section>

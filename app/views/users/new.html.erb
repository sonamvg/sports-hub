<section class="page-shell">
  <div class="container narrow">
    <% organizer_account = @account_type == "organizer" %>
    <% academy_owner_account = @account_type == "academy_owner" %>
    <p class="eyebrow"><%= organizer_account ? "ORGANIZER ACCOUNT" : (academy_owner_account ? "ACADEMY ACCOUNT" : "ATHLETE ACCOUNT") %></p>
    <h1 class="page-title"><%= organizer_account ? "Create organizer account" : (academy_owner_account ? "Register academy" : "Join as athlete") %></h1>
    <p class="page-copy">
      <% if organizer_account %>
        Create an organizer account. Your profile will be reviewed and approved before you can publish tournaments, manage categories, or review registrations.
      <% elsif academy_owner_account %>
        Create your own sign-in account first. On the next page you'll add your academy's name and details to submit it for approval.
      <% else %>
        Create an athlete account. No approval is required; after signup you will complete your athlete profile.
      <% end %>
    </p>

    <%= form_with model: @user, class: "form-card" do |form| %>
      <%= render "shared/errors", record: @user %>
      <%= hidden_field_tag :account_type, @account_type %>
      <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>
      <p class="field-hint"><span class="required-marker">*</span> indicates a required field.</p>
      <div class="form-grid two-col">
        <div>
          <%= form.label :name do %><%= academy_owner_account ? "Your name" : "Name" %><span class="required-marker">*</span><% end %>
          <%= form.text_field :name, required: true, autocomplete: "name", pattern: "[a-zA-Z\\s'\\-]+", title: "Letters, spaces, hyphens, and apostrophes only" %>
          <%= field_error(@user, :name) %>
          <% if academy_owner_account %>
            <p class="field-hint">This is your own name, not the academy's. You'll add your academy's name and details on the next page.</p>
          <% end %>
        </div>
        <div><%= form.label :phone do %><%= organizer_account ? "Mobile number" : "Phone number" %><% if organizer_account || (!academy_owner_account && !organizer_account) %><span class="required-marker">*</span><% end %><% end %><%= form.telephone_field :phone, required: organizer_account || (!academy_owner_account && !organizer_account), autocomplete: "tel", pattern: "\\d{10}", maxlength: 10, title: "10-digit mobile number" %><%= field_error(@user, :phone) %></div>
        <% if organizer_account %>
          <div>
            <%= form.label :organizer_designation do %>Designation<span class="required-marker">*</span><% end %>
            <%= form.text_field :organizer_designation, required: true, placeholder: "Tournament director, coach, academy owner" %>
            <%= field_error(@user, :organizer_designation) %>
          </div>
          <div class="full">
            <%= form.label :profile_photo, "Profile photo" %>
            <%= form.file_field :profile_photo, accept: "image/png,image/jpeg,image/jpg,.jpg,.jpeg,.png" %>
            <%= field_error(@user, :profile_photo) %>
            <p class="field-hint">Optional. .jpg, .jpeg, or .png up to 5 MB. Appears on the public organizer directory after verification.</p>
          </div>
          <div class="full">
            <%= form.label :profile_photo_url, "Profile photo URL (optional)" %>
            <%= form.url_field :profile_photo_url, placeholder: "https://example.com/photo.jpg" %>
            <%= field_error(@user, :profile_photo_url) %>
            <p class="field-hint">Only used if no photo is uploaded above.</p>
          </div>
          <div class="full">
            <%= form.label :identity_document do %>Identity verification document<span class="required-marker">*</span><% end %>
            <%= form.file_field :identity_document, required: true, accept: "image/png,image/jpeg,application/pdf" %>
            <%= field_error(@user, :identity_document) %>
            <p class="field-hint">Upload one document such as Aadhaar or another identity proof. PDF, JPG, or PNG up to 5 MB is accepted.</p>
          </div>
        <% end %>
        <div class="full"><%= form.label :email do %>Email<span class="required-marker">*</span><% end %><%= form.email_field :email, required: true, autocomplete: "email" %><%= field_error(@user, :email) %></div>
        <div><%= form.label :password do %>Password<span class="required-marker">*</span><% end %><%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, pattern: "(?=.*[A-Za-z])(?=.*\\d)\\S{8,}", title: "At least 8 characters, with a letter and a number, and no spaces" %><%= field_error(@user, :password) %></div>
        <div><%= form.label :password_confirmation do %>Confirm password<span class="required-marker">*</span><% end %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %><%= field_error(@user, :password_confirmation) %></div>
      </div>
      <div class="form-actions">
        <%= form.submit organizer_account ? "Create organizer account" : (academy_owner_account ? "Register academy" : "Create athlete account"), class: "primary-button button-reset" %>
        <%= link_to "Sign in", login_path(return_to: params[:return_to]), class: "secondary-button" %>
      </div>
    <% end %>
  </div>
</section>

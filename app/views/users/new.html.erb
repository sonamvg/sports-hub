<section class="page-shell">
  <div class="container narrow">
    <% organizer_account = @account_type == "organizer" %>
    <p class="eyebrow"><%= organizer_account ? "ORGANIZER ACCOUNT" : "ATHLETE ACCOUNT" %></p>
    <h1 class="page-title"><%= organizer_account ? "Create organizer account" : "Join as athlete" %></h1>
    <p class="page-copy">
      <% if organizer_account %>
        Create an organizer account to publish tournaments, manage categories, and review registrations.
      <% else %>
        Create a general athlete or parent account to add athletes and register for tournaments.
      <% end %>
    </p>

    <%= form_with model: @user, class: "form-card" do |form| %>
      <%= render "shared/errors", record: @user %>
      <%= hidden_field_tag :account_type, @account_type %>
      <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>
      <div class="form-grid two-col">
        <div><%= form.label :name %><%= form.text_field :name, required: true, autocomplete: "name" %></div>
        <div><%= form.label :phone %><%= form.telephone_field :phone, autocomplete: "tel" %></div>
        <div class="full"><%= form.label :email %><%= form.email_field :email, required: true, autocomplete: "email" %></div>
        <div><%= form.label :password %><%= form.password_field :password, required: true, autocomplete: "new-password" %></div>
        <div><%= form.label :password_confirmation %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %></div>
      </div>
      <div class="form-actions">
        <%= form.submit organizer_account ? "Create organizer account" : "Create athlete account", class: "primary-button button-reset" %>
        <%= link_to "Sign in", login_path(return_to: params[:return_to]), class: "secondary-button" %>
      </div>
    <% end %>
  </div>
</section>

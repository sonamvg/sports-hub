<!DOCTYPE html>
<html>
  <head>
    <title>Sports Hub</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>
  <body>
    <div class="app-frame">
      <aside class="side-menu" aria-label="Primary navigation">
        <%= link_to root_path, class: "brand" do %>SPORTS <span>HUB</span><% end %>
        <nav class="side-nav">
          <%= link_to tournaments_path, class: "side-nav-link" do %><%= ui_icon("trophy") %><span>Tournaments</span><% end %>
          <%= link_to current_user&.athlete? ? athlete_home_path : athletes_path, class: "side-nav-link" do %><%= ui_icon("medal") %><span>Athletes</span><% end %>
          <%= link_to academies_path, class: "side-nav-link" do %><%= ui_icon("academy") %><span>Academies</span><% end %>
          <%= link_to current_user&.can_organize_tournaments? ? profile_organizers_path : organizers_path, class: "side-nav-link" do %><%= ui_icon("shield") %><span>Organizer</span><% end %>
          <% if current_user&.academy_owner? %>
            <% owned_academies = current_user.owned_academies.order(:created_at) %>
            <% if owned_academies.any? %>
              <div class="side-nav-group">
                <span>My academies</span>
                <% owned_academies.each do |academy| %>
                  <details class="side-tournament">
                    <summary><%= academy.name %></summary>
                    <div class="side-tournament-links">
                      <%= link_to edit_academy_path(academy) do %><%= ui_icon("edit") %><span>Edit academy</span><% end %>
                      <%= link_to athletes_academy_path(academy) do %><%= ui_icon("medal") %><span>My athletes</span><% end %>
                      <%= link_to notifications_academy_path(academy) do %><%= ui_icon("user") %><span>Notifications</span><% end %>
                    </div>
                  </details>
                <% end %>
              </div>
            <% end %>
          <% end %>
          <% if current_user&.can_organize_tournaments? %>
            <% organizer_tournaments = (current_user.organized_tournaments.to_a + current_user.collaborating_tournaments.to_a).uniq(&:id).sort_by(&:created_at).reverse %>
            <% if organizer_tournaments.any? %>
              <div class="side-nav-group">
                <span>My tournaments</span>
                <% organizer_tournaments.each do |tournament| %>
                  <details class="side-tournament">
                    <summary><%= tournament.name %></summary>
                    <div class="side-tournament-links">
                      <%= link_to edit_tournament_path(tournament) do %><%= ui_icon("edit") %><span>Edit</span><% end %>
                      <%= link_to tournament_tournament_referees_path(tournament) do %><%= ui_icon("user") %><span>Add referees</span><% end %>
                      <%= link_to venue_setup_tournament_path(tournament) do %><%= ui_icon("home") %><span>Venue setup</span><% end %>
                      <%= link_to organizer_tournament_weight_checks_path(tournament) do %><%= ui_icon("search") %><span>Weight check</span><% end %>
                      <% if tournament.draw_scheduling? %>
                        <%= link_to draw_tournament_path(tournament) do %><%= ui_icon("calendar") %><span>Set draw</span><% end %>
                      <% elsif tournament.registration_closed_for_weight_check? %>
                        <%= button_to set_draw_tournament_path(tournament), method: :patch, class: "link-button side-action-button" do %><%= ui_icon("calendar") %><span>Set draw</span><% end %>
                      <% else %>
                        <span class="side-disabled"><%= ui_icon("calendar") %><span>Set draw</span></span>
                      <% end %>
                    </div>
                  </details>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </nav>

        <div class="side-account">
          <% if current_user %>
            <span class="status-pill"><%= user_first_name(current_user) %></span>
            <%= button_to logout_path, method: :delete, class: "link-button account-action" do %><%= ui_icon("log-out") %><span>Sign out</span><% end %>
          <% else %>
            <%= link_to login_path, class: "side-nav-link" do %><%= ui_icon("user") %><span>Sign in</span><% end %>
            <% if params[:return_to] == new_tournament_path %>
              <%= link_to "Create organizer account", new_user_path(account_type: "organizer", return_to: params[:return_to]), class: "nav-button" %>
            <% elsif params[:return_to] == new_academy_path %>
              <%= link_to "Register academy", new_user_path(account_type: "academy_owner", return_to: params[:return_to]), class: "nav-button" %>
            <% else %>
              <%= link_to "Join as athlete", new_user_path, class: "nav-button" %>
            <% end %>
          <% end %>
        </div>
      </aside>

      <div class="app-content">
        <%= render "shared/flash" %>
        <%= yield %>
      </div>
    </div>
  </body>
</html>

<!DOCTYPE html>
<html>
  <head>
    <title>Sports Hub</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body>
    <div class="app-frame">
      <aside class="side-menu" aria-label="Primary navigation">
        <%= link_to root_path, class: "brand" do %>SPORTS <span>HUB</span><% end %>
        <nav class="side-nav">
          <%= link_to "Tournaments", tournaments_path, class: "side-nav-link" %>
          <%= link_to "Athletes", current_user&.athlete? ? athlete_home_path : athletes_path, class: "side-nav-link" %>
          <%= link_to "Academies", academies_path, class: "side-nav-link" %>
          <%= link_to "Organizer", current_user&.can_organize_tournaments? ? profile_organizers_path : organizers_path, class: "side-nav-link" %>
          <% if current_user&.can_organize_tournaments? %>
            <% organizer_tournaments = (current_user.organized_tournaments.to_a + current_user.collaborating_tournaments.to_a).uniq(&:id).sort_by(&:created_at).reverse %>
            <% if organizer_tournaments.any? %>
              <div class="side-nav-group">
                <span>My tournaments</span>
                <% organizer_tournaments.each do |tournament| %>
                  <details class="side-tournament">
                    <summary><%= tournament.name %></summary>
                    <div class="side-tournament-links">
                      <%= link_to "Edit", edit_tournament_path(tournament) %>
                      <%= link_to "Add referees", tournament_tournament_referees_path(tournament) %>
                      <%= link_to "Venue setup", venue_setup_tournament_path(tournament) %>
                      <%= link_to "Weight check", organizer_tournament_weight_checks_path(tournament) %>
                      <% if tournament.draw_scheduling? %>
                        <%= link_to "Set draw", draw_tournament_path(tournament) %>
                      <% elsif tournament.registration_closed_for_weight_check? %>
                        <%= button_to "Set draw", set_draw_tournament_path(tournament), method: :patch, class: "link-button side-action-button" %>
                      <% else %>
                        <span class="side-disabled">Set draw</span>
                      <% end %>
                    </div>
                  </details>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </nav>

        <div class="side-account">
          <% if current_user %>
            <span class="status-pill"><%= current_user.role.humanize %></span>
            <%= button_to "Sign out", logout_path, method: :delete, class: "link-button" %>
          <% else %>
            <%= link_to "Sign in", login_path, class: "side-nav-link" %>
            <% if params[:return_to] == new_tournament_path %>
              <%= link_to "Create organizer account", new_user_path(account_type: "organizer", return_to: params[:return_to]), class: "nav-button" %>
            <% elsif params[:return_to] == new_academy_path %>
              <%= link_to "Create academy owner account", new_user_path(account_type: "academy_owner", return_to: params[:return_to]), class: "nav-button" %>
            <% else %>
              <%= link_to "Join as athlete", new_user_path, class: "nav-button" %>
            <% end %>
          <% end %>
        </div>
      </aside>

      <div class="app-content">
        <%= render "shared/flash" %>
        <%= yield %>
      </div>
    </div>
  </body>
</html>

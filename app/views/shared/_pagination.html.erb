<% if pagination[:total_pages] > 1 %>
  <nav class="pagination" aria-label="Pagination">
    <% if pagination[:page] > 1 %>
      <%= link_to "Previous", url_for(request.query_parameters.merge(page: pagination[:page] - 1)), class: "secondary-button" %>
    <% end %>
    <span>Page <%= pagination[:page] %> of <%= pagination[:total_pages] %></span>
    <% if pagination[:page] < pagination[:total_pages] %>
      <%= link_to "Next", url_for(request.query_parameters.merge(page: pagination[:page] + 1)), class: "secondary-button" %>
    <% end %>
  </nav>
<% end %>

<%
  city_required ||= false
  state_required ||= false
  country_required ||= false
%>
<div>
  <% if city_required %>
    <%= form.label :city do %>City<span class="required-marker">*</span><% end %>
  <% else %>
    <%= form.label :city %>
  <% end %>
  <%= form.text_field :city, required: city_required %>
  <%= field_error(record, :city) %>
</div>
<div>
  <% if state_required %>
    <%= form.label :state do %>State<span class="required-marker">*</span><% end %>
  <% else %>
    <%= form.label :state %>
  <% end %>
  <%= form.select :state, IndianLocation::STATES, { include_blank: "Select state" }, required: state_required %>
  <%= field_error(record, :state) %>
</div>
<div>
  <% if country_required %>
    <%= form.label :country do %>Country<span class="required-marker">*</span><% end %>
  <% else %>
    <%= form.label :country %>
  <% end %>
  <%= form.select :country, IndianLocation::COUNTRIES, { selected: record.country.presence || "India" }, required: country_required %>
  <%= field_error(record, :country) %>
</div>
<div>
  <%= form.label :pincode, "PIN code" %>
  <%= form.text_field :pincode, inputmode: "numeric", maxlength: 6, pattern: "[0-9]{6}", placeholder: "e.g. 411001" %>
  <%= field_error(record, :pincode) %>
</div>
